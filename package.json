{
  "name": "fudic",
  "version": "0.0.0",
  "private": true,
  "description": "fudic monorepo — a UI framework based on Declarative Shadow DOM.",
  "type": "module",
  "license": "MIT",
  "author": "Pedro Hurtado",
  "homepage": "https://github.com/fudiePlatform/fudic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fudiePlatform/fudic.git"
  },
  "bugs": {
    "url": "https://github.com/fudiePlatform/fudic/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build && node examples/pieces-bench/check.mjs .",
    "registry": "node scripts/local-registry.mjs",
    "verify:generated": "node scripts/verify-generated.mjs",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail --workspace-concurrency=1 test",
    "coverage": "pnpm -r --no-bail --workspace-concurrency=1 coverage",
    "test:e2e": "pnpm --filter @fudic/example-basic test:e2e",
    "check:pieces": "node examples/pieces-bench/check.mjs ."
  },
  "devDependencies": {
    "@fudic/tsconfig": "workspace:*",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "5.9.3",
    "verdaccio": "6.9.1",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
