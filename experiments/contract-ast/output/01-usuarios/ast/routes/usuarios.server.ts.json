 "comments": [
  {
   "type": "Block",
   "value": "*\n * The server of `/usuarios`, in one file: what `examples/basic/src/routes/usuarios.fud` writes\n * today in its `@server`, without a single `handle`, and the types it sends and receives.\n ",
   "start": 0,
   "end": 194
  },
  {
   "type": "Block",
   "value": "* Per request: the list changes with every new person. ",
   "start": 407,
   "end": 466
  },
  {
   "type": "Block",
   "value": "* Public: no `auth`. ",
   "start": 524,
   "end": 549
  },
  {
   "type": "Block",
   "value": "* The same search, three seconds late: time to cancel it. ",
   "start": 592,
   "end": 654
  },
  {
   "type": "Block",
   "value": "* A failure nobody catches: `errorPages` takes the page to `_error.fud` with a 500. ",
   "start": 831,
   "end": 919
  }
 ],
