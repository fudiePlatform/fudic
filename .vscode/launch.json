{
  // See EXTENSION-DEV.md at the repo root.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fudic: extension (Extension Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        // Opens the language server fixtures: the real workspace of the acceptance criteria,
        // with all four pieces (a route, a layout and two components).
        "${workspaceFolder}/packages/language-server/fixtures"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.cjs"],
      "preLaunchTask": "fudic: build extension"
    },
    {
      // Attaches to the *server*, which runs in its own process. Requires the configuration
      // above to have been launched first: the client forks the server with `--inspect=6009`
      // when the host is in debug.
      "name": "Fudic: attach to language server",
      "type": "node",
      "request": "attach",
      "port": 6009,
      "restart": true,
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.mjs"]
    }
  ],
  "compounds": [
    {
      "name": "Fudic: extension + server",
      "configurations": [
        "Fudic: extension (Extension Development Host)",
        "Fudic: attach to language server"
      ]
    }
  ]
}
