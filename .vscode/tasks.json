{
  // Ver INSTALAR-EXTENSION-DEV.md en la raíz del repo.
  "version": "2.0.0",
  "tasks": [
    {
      // `fudic-vscode...` (con los tres puntos) construye el paquete **y sus dependencias**:
      // compiler → language-core → language-server → vscode. Sin ellas, el bundle del
      // servidor no tiene qué empaquetar, porque se arma desde el `dist` de sus hermanos.
      "label": "fudic: construir extensión",
      "type": "shell",
      "command": "pnpm --filter \"fudic-vscode...\" build",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "fudic: vigilar la extensión",
      "type": "shell",
      "command": "pnpm --filter fudic-vscode dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
