manual_test/
# Dependencies
node_modules/

# Agent worktrees: transient, created by parallel subagent runs. Their commits
# are merged to main before removal, so nothing here is ever committed.
.claude/worktrees/

# Build / emit output
dist/
# Packaged VS Code extension: a build artefact of `pnpm --filter fudic-vscode package`.
*.vsix
out/
*.tsbuildinfo

# Test / coverage
coverage/
# Playwright run artifacts (traces, screenshots): regenerated on every run.
test-results/
playwright-report/

# Forbidden lockfiles: pnpm is the only package manager (SDD-00 §3.3).
# Only pnpm-lock.yaml is committed.
package-lock.json
yarn.lock

# Local environment
.env
.env*.local

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Server-only build artifacts: never published (BUG-09)
.fudic/

# Storage of the local Verdaccio (`pnpm registry`): rebuilt from scratch on every run,
# because a registry serving a tarball from a previous build is worse than no registry.
.local-registry/
