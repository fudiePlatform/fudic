exports[`fudic new, without --workspace > writes the standalone tree, byte for byte (criterion 2) 1`] = `
{
  "demo/.gitattributes": "# The history of each piece only grows: two branches that add lines join without a conflict.
*.fudlog merge=union
",
  "demo/.gitignore": "node_modules/
dist/
.fudic/
*.local
.DS_Store
",
  "demo/.mcp.json": "{ "mcpServers": { "fudic": { "command": "pnpm", "args": ["exec", "fudic-mcp"] } } }
",
  "demo/AGENTS.md": "This is a fudic project. fudic is a framework you have no prior knowledge of.
Use the fudic MCP server (it is configured in .mcp.json): call fudic_status first.
To use it from a chat, run \`pnpm exec fudic-mcp --http --tunnel\` and add the URL as a connector.
",
  "demo/CLAUDE.md": "@AGENTS.md
",
  "demo/README.md": "# demo

A [fudic](https://github.com/fudiePlatform/fudic) app: pages and components written as \`.fud\`
files, served as HTML with Declarative Shadow DOM.

\`\`\`sh
pnpm run dev        # serve it while you work on it
pnpm run build      # build it into dist/
pnpm run preview    # serve the build
pnpm run test       # unit tests, src/**/*.test.ts
pnpm run spec       # .fudspec criteria, in a browser
\`\`\`

## What is here

- \`src/routes/index.fud\`: the page at \`/\`, and \`index.test.ts\` its unit test.
- \`src/layouts/_layout.fud\`: the frame every page is written into, and \`_layout.test.ts\` its unit test.
- \`src/guide/\`: the style guide — tokens with a dark mode, the font, the favicon and a sheet per element. Every page links it; a component adopts its pieces by name, \`shadowrootadoptedstylesheets="button"\`.
- \`fudic.json\`: its id, and the tag prefix of its components (\`-\`).
- \`sw.json\`: what the Service Worker caches; delete it for no Service Worker.
- \`page.headers\`, \`sw.headers\` and \`assets.headers\`: the headers of its pages (the CSP among them), of its Service Worker and of its static files. What is in them is what is sent.
- \`vite.config.ts\`: the dev server and the build. \`vitest.config.ts\`: the unit tests.

Components go to \`src/components/\`, one folder each, when you generate them.

## Never change the \`id\` in \`fudic.json\`

The Service Worker names its caches after it. Change it, and the caches of the old one stay in
the browser of everyone who visited the app, and nothing ever deletes them.

## Add to it

\`\`\`sh
fudic g component card --in src/routes/index.fud   # <-card>, linked from the home page
fudic g page blog
fudic g layout admin --sections aside
\`\`\`
",
  "demo/assets.headers": "# The headers of the app's static files, by path without the base.
# The most specific path wins, header by header. An empty value sends nothing.

/**
  Cache-Control: no-cache

/assets/**
  Cache-Control: public, max-age=31536000, immutable
",
  "demo/fudic-globals.d.ts": "// Generated by fudic. Do not edit.
declare function props<T>(): T;

type $Scalar = string | number | boolean | bigint | null | undefined;

type $GlobalAttrs = {
  accesskey?: $Scalar;
  autocapitalize?: $Scalar;
  autocorrect?: $Scalar;
  autofocus?: $Scalar;
  class?: $Scalar;
  contenteditable?: $Scalar;
  contextmenu?: $Scalar;
  dir?: $Scalar;
  draggable?: $Scalar;
  dropzone?: $Scalar;
  enterkeyhint?: $Scalar;
  exportparts?: $Scalar;
  hidden?: $Scalar;
  id?: $Scalar;
  inert?: $Scalar;
  inputmode?: $Scalar;
  is?: $Scalar;
  itemid?: $Scalar;
  itemprop?: $Scalar;
  itemref?: $Scalar;
  itemscope?: $Scalar;
  itemtype?: $Scalar;
  lang?: $Scalar;
  nonce?: $Scalar;
  part?: $Scalar;
  popover?: $Scalar;
  role?: $Scalar;
  spellcheck?: $Scalar;
  style?: $Scalar;
  tabindex?: $Scalar;
  title?: $Scalar;
  translate?: $Scalar;
  virtualkeyboardpolicy?: $Scalar;
  'aria-activedescendant'?: $Scalar;
  'aria-atomic'?: $Scalar;
  'aria-autocomplete'?: $Scalar;
  'aria-busy'?: $Scalar;
  'aria-checked'?: $Scalar;
  'aria-colcount'?: $Scalar;
  'aria-colindex'?: $Scalar;
  'aria-colspan'?: $Scalar;
  'aria-controls'?: $Scalar;
  'aria-current'?: $Scalar;
  'aria-describedby'?: $Scalar;
  'aria-disabled'?: $Scalar;
  'aria-dropeffect'?: $Scalar;
  'aria-errormessage'?: $Scalar;
  'aria-expanded'?: $Scalar;
  'aria-flowto'?: $Scalar;
  'aria-grabbed'?: $Scalar;
  'aria-haspopup'?: $Scalar;
  'aria-hidden'?: $Scalar;
  'aria-invalid'?: $Scalar;
  'aria-label'?: $Scalar;
  'aria-labelledby'?: $Scalar;
  'aria-level'?: $Scalar;
  'aria-live'?: $Scalar;
  'aria-modal'?: $Scalar;
  'aria-multiline'?: $Scalar;
  'aria-multiselectable'?: $Scalar;
  'aria-orientation'?: $Scalar;
  'aria-owns'?: $Scalar;
  'aria-placeholder'?: $Scalar;
  'aria-posinset'?: $Scalar;
  'aria-pressed'?: $Scalar;
  'aria-readonly'?: $Scalar;
  'aria-relevant'?: $Scalar;
  'aria-required'?: $Scalar;
  'aria-roledescription'?: $Scalar;
  'aria-rowcount'?: $Scalar;
  'aria-rowindex'?: $Scalar;
  'aria-rowspan'?: $Scalar;
  'aria-selected'?: $Scalar;
  'aria-setsize'?: $Scalar;
  'aria-sort'?: $Scalar;
  'aria-valuemax'?: $Scalar;
  'aria-valuemin'?: $Scalar;
  'aria-valuenow'?: $Scalar;
  'aria-valuetext'?: $Scalar;
  'aria-details'?: $Scalar;
  'aria-keyshortcuts'?: $Scalar;
} & { [k: \`data-\${string}\`]: $Scalar } & { [k: \`aria-\${string}\`]: $Scalar };

declare function $text(v: $Scalar): void;
declare function $attr(v: $Scalar): void;
interface $TrustedURL { readonly fudicTrustedUrl: string }
declare function $url(v: $Scalar | $TrustedURL): void;
interface $TrustedHTML { readonly fudicTrustedHtml: string }
declare function $raw(v: $TrustedHTML | null | undefined): void;
interface $Pipe<in T> { readonly kind: string; format(value: T, locale: string): string }
declare function $pipe<T>(value: NoInfer<T>, pipe: $Pipe<T>): string;
declare function $attrs<T>(a: T & $GlobalAttrs): void;

declare function $props<T>(p: T): void;

declare function $gap<T>(a: { [K in keyof T & string as \`.\${K}\`]?: T[K] } & $GlobalAttrs): void;

type $RequiredKeys<T> = { [K in keyof T]-?: {} extends Pick<T, K> ? never : K }[keyof T];
type $Missing<T, K> = Pick<T, Exclude<$RequiredKeys<T>, K>>;

declare function $required<T, K extends PropertyKey>(rest: $Missing<T, K>): void;
declare function $spread<T>(o: T): void;
declare function $spreadAttrs(o: object | null | undefined): void;
interface $FudicEvents {
  'fudic:result': CustomEvent<unknown>;
  'fudic:error': CustomEvent<unknown>;
}
type $Events = HTMLElementEventMap & $FudicEvents;
declare function $on<K extends keyof $Events>(
  type: K, h: (ev: $Events[K]) => unknown): void;
type $Result<F> = F extends (...a: never[]) => infer R ? Awaited<R> : unknown;
declare function $onResult<F>(fn: F, h: (value: $Result<F>) => unknown): void;
declare function $onResultEvent<F>(fn: F, h: (ev: CustomEvent<$Result<F>>) => unknown): void;
interface FudicFormResults {}
type $FormResult<K extends string> = K extends keyof FudicFormResults ? FudicFormResults[K] : never;
interface $NoFormHere { readonly '$this component sends no form': never }
type $ResultHandler<R, A> = [R] extends [never] ? $NoFormHere : (value: A) => unknown;
declare function $onResultOf<K extends string>(h: $ResultHandler<$FormResult<K>, $FormResult<K>>): void;
declare function $onResultOfEvent<K extends string>(
  h: $ResultHandler<$FormResult<K>, CustomEvent<$FormResult<K>>>): void;
declare function $onError(h: (error: Error) => unknown): void;
declare function $onErrorEvent(h: (ev: CustomEvent<Error>) => unknown): void;
type $BusDetail<K extends string> = import('@fudic/dom').BusDetail<K>;
type $BusParam<F> = import('@fudic/dom').BusParam<F>;
declare function $busOn<K extends string>(name: K, h: (detail: $BusDetail<K>) => unknown): void;
declare function $busEvent<K extends string>(name: K, h: (ev: CustomEvent<$BusDetail<K>>) => unknown): void;
declare function $busOnAny(name: unknown, h: (detail: any) => unknown): void;
declare function $busEventAny(name: unknown, h: (ev: CustomEvent<any>) => unknown): void;
declare function $section<T extends string>(name: T): void;
declare function $cls(v: boolean): void;
declare function $sty(v: string): void;
declare function $slot(): void;
declare function $intoSlot<T extends string>(name: T): void;
declare function $ref<E extends Element>(): E;

declare function $control(node: $ControlNode): void;

declare function $controlGroup(node: $FormNode): void;

declare function $formSend(fn: (...args: never[]) => unknown): void;

declare function $errorOf(node: $ControlNode | $FormNode): void;

type $ControlNode = { (): unknown; set(v: never): void; touch(): void };

type $FormNode = { $touch(): void; $validate(...args: never[]): unknown };

declare function $node<V>(node: V): V;

declare function $cross<V>(source: V | (() => V)): V;

type $Prop<T, K extends PropertyKey> = K extends keyof T ? Exclude<T[K], undefined> : unknown;

declare function $key(k?: unknown): void;

declare function $empty(): boolean;

declare function $await<D, K extends keyof D>(data: D, field: K): Omit<D, K> & { readonly [P in K]: Awaited<D[P]> };

interface $Problem {
  /** The HTTP status: 404, 500… */
  readonly status: number;
  /** The standard name of the status: \`Not Found\`. */
  readonly title: string;
  /** What the server said, in development only. */
  readonly detail?: string;
}

/** The \`Problem\` of the \`@catch\` being projected. Opaque, like \`$empty\`. */
declare function $problem(): $Problem;

type $El<T extends string> = T extends keyof HTMLElementTagNameMap
  ? HTMLElementTagNameMap[T]
  : HTMLElement;

interface $LayoutContext<P extends string> {
  /** Who renders this response: the server in process, the Service Worker, or the build. */
  readonly origin: 'edge' | 'sw' | 'ssg';
  readonly url: URL;
  readonly params: Readonly<Record<P, string>>;
}

interface $LoadContext<P extends string> {
  readonly side: 'server';
  readonly method: 'GET';
  /** Always \`load\`. */
  readonly name: string;
  readonly url: URL;
  readonly headers: Headers;
  readonly args: unknown;
  readonly signal: AbortSignal;
  readonly params: Readonly<Record<P, string>>;
  readonly cookies: ReadonlyMap<string, string>;
  /** What the response carries besides the page: its status and headers (Set-Cookie…). */
  readonly response: { status: number; readonly headers: Headers };
}
",
  "demo/fudic.json": "{
  "id": "demo",
  "kind": "app",
  "server": "src/server",
  "browser": "src/browser",
  "baseline": "widely",
  "globalStyles": { "base": "src/guide/base.css" },
  "guide": { "sheet": "src/guide/guide.css", "icon": "src/guide/logo.svg" }
}
",
  "demo/package.json": "{
  "name": "demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "spec": "fudic-workbench run --pass-with-no-specs"
  },
  "dependencies": {
    "@fudic/core": "0.0.1",
    "@fudic/dom": "0.0.1",
    "@fudic/ssr": "0.0.1",
    "@fudic/transport": "0.0.1"
  },
  "devDependencies": {
    "@fudic/cli": "0.0.1",
    "@fudic/mcp": "0.0.1",
    "@fudic/terms": "0.0.1",
    "@fudic/testing": "0.0.1",
    "@fudic/vite": "0.0.1",
    "@fudic/workbench": "0.0.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
",
  "demo/page.headers": "# The headers of every page: what the server sends and what the Service Worker paints.
# The 103 Early Hints carry only the Content-Security-Policy and the Referrer-Policy.
# {nonce} is the nonce of each response: fudic writes it on its own scripts and styles.

Content-Security-Policy:
  default-src 'self'
  script-src 'nonce-{nonce}' 'strict-dynamic' 'unsafe-inline' https:
  style-src 'self' 'unsafe-inline'
  img-src 'self' data:
  object-src 'none'
  base-uri 'none'
  frame-ancestors 'none'
  require-trusted-types-for 'script'
  trusted-types fudic
Referrer-Policy: strict-origin-when-cross-origin
Cross-Origin-Opener-Policy: same-origin
Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
",
  "demo/src/browser/.gitkeep": "",
  "demo/src/fudic-env.d.ts": "// Lets a .ts file import a .fud component: its tests and its fixtures.
declare module '*.fud' {
  export type $Props = any;
  export const tag: string;
  export const css: string;
  export function render(...args: never[]): unknown;
  export const $file: string;
}
",
  "demo/src/layouts/_layout.fud": "<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* Keep this line: fudic puts its scripts here. *@
    <script type="module" src="fudic:runtime"></script>
    @RenderHead()
  </head>
  <body>

    <main>@RenderBody()</main>
  </body>
</html>
",
  "demo/src/layouts/_layout.test.ts": "import { expect, test } from 'vitest';
import { renderLayout } from '@fudic/testing';
import * as Layout from './_layout.fud';

test('renders the page inside it', async () => {
  const page = await renderLayout(Layout, { body: '<p>Hello</p>' });
  expect(page.document.querySelector('main')?.textContent).toContain('Hello');
});
",
  "demo/src/routes/index.fud": "<link rel="layout" href="../layouts/_layout.fud">

<head>
  <title>Home</title>
</head>

<h1>Home</h1>
",
  "demo/src/routes/index.test.ts": "import { expect, test } from 'vitest';
import { visit } from '@fudic/testing';

test('answers /', async () => {
  const page = await visit('/');
  expect(page.status).toBe(200);
});
",
  "demo/src/server/.gitkeep": "",
  "demo/sw.headers": "# The headers of /fudic-sw.js. A Service Worker does not inherit the page's policy.
# 'unsafe-eval' is what lets it link the route chunks: without it the app is served without it.

Content-Security-Policy:
  default-src 'self'
  script-src 'self' 'unsafe-eval'
",
  "demo/sw.json": "{
  "shell": [],
  "resources": {
    "assets": {
      "pattern": "/assets/**",
      "policy": "cache-first",
      "ttl": null,
      "maxEntries": 200
    }
  },
  "dev": "off"
}
",
  "demo/tsconfig.json": "{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.fud", "fudic-globals.d.ts", ".fudic/api/**/*.d.ts"]
}
",
  "demo/vite.config.ts": "import { defineConfig } from 'vite';
import { fudic } from '@fudic/vite';

// Pages are the .fud files under src/routes/; fudic() needs nothing else to serve and build them.
export default defineConfig({
  plugins: [fudic()],
});
",
  "demo/vitest.config.ts": "import { defineConfig } from 'vitest/config';
import { fudicTest } from '@fudic/testing/config';

// Unit tests live next to what they test, as src/**/*.test.ts.
export default defineConfig({
  plugins: [fudicTest()],
  test: { include: ['src/**/*.test.ts'], passWithNoTests: true },
});
",
}
`;
