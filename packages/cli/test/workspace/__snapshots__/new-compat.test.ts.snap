// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`fudic new, without --workspace > writes the standalone tree, byte for byte (criterion 2) 1`] = `
{
  "demo/.gitignore": "node_modules/
dist/
.fudic/
*.local
.DS_Store
",
  "demo/README.md": "# demo

A [fudic](https://github.com/fudiePlatform/fudic) app: single-file \`.fud\` components compiled to
Declarative Shadow DOM.

\`\`\`sh
pnpm install
pnpm run dev        # dev server
pnpm run build      # static + incremental SSG build
pnpm run preview    # serve the build
\`\`\`

## Layout

\`\`\`
src/layouts/_layout.fud   the shell every route shares (@RenderBody / @RenderHead)
src/routes/index.fud      the \`/\` route
src/components/           components, wired with <link rel="component">
fudic.json                who this project is: its id, and the prefix it proposes
sw.json                   Service Worker policy; delete it and no SW is emitted
\`\`\`

## The \`id\` in \`fudic.json\` is never changed

It is what the Service Worker caches are named after. Change it and the caches written
under the old one stop matching anybody's name — no worker ever purges them again, and
they sit in the browser of everyone who visited the old build forever. It is not the
directory name and not the npm name on purpose: those two move, and this one must not.

Add pieces with the CLI — it writes the wiring for you:

\`\`\`sh
fudic g component app-card --in src/routes/index.fud
fudic g page blog
fudic g layout admin --sections aside
\`\`\`
",
  "demo/fudic-globals.d.ts": "// Generated by fudic. Do not edit.
declare function props<T>(): T;

type $Scalar = string | number | boolean | bigint | null | undefined;

/**
 * The attributes an element understands for BEING an element, not for being this component.
 *
 * They live here and not in a list inside the emitter, and that is the whole of BUG-11: the
 * vocabulary HTML defines belongs with the rest of what HTML defines. The emitter does not
 * learn that \`id\` or \`data-*\` exist; it hands the object literal to a type that does.
 *
 * \`slot\` is deliberately NOT here. Its value is checked against the component's own
 * \`$Slots\`, so declaring it as a plain string would give up exactly the name checking and
 * the completion that make it worth projecting at all.
 *
 * The members are GENERATED from \`HTML_ATTRIBUTES\`, which is the data VS Code answers a
 * \`.html\` with. It used to be eleven names written by hand, and eleven is what made a component
 * poorer than a \`<div>\`: a native tag is answered by the HTML service with its whole
 * vocabulary, so \`<div |>\` offered \`accesskey\` and every \`aria-*\` while \`<app-input |>\`
 * offered a curated fraction. A component is HTML with more in it, never with less.
 *
 * One list, both jobs: what is OFFERED at an empty position is enumerated from this type, and
 * what is ACCEPTED when written is checked against it. They cannot drift, because they are the
 * same sentence — the editor can never offer a name that then underlines in red.
 *
 * The index signatures stay even though every \`aria-*\` is now enumerated: enumerating is what
 * OFFERS them, the signature is what ACCEPTS the ones this version of the data has not heard of
 * yet, and a \`data-*\` is the author's own vocabulary and can never be enumerated at all.
 */
type $GlobalAttrs = {
  accesskey?: $Scalar;
  autocapitalize?: $Scalar;
  autocorrect?: $Scalar;
  autofocus?: $Scalar;
  class?: $Scalar;
  contenteditable?: $Scalar;
  contextmenu?: $Scalar;
  dir?: $Scalar;
  draggable?: $Scalar;
  dropzone?: $Scalar;
  enterkeyhint?: $Scalar;
  exportparts?: $Scalar;
  hidden?: $Scalar;
  id?: $Scalar;
  inert?: $Scalar;
  inputmode?: $Scalar;
  is?: $Scalar;
  itemid?: $Scalar;
  itemprop?: $Scalar;
  itemref?: $Scalar;
  itemscope?: $Scalar;
  itemtype?: $Scalar;
  lang?: $Scalar;
  nonce?: $Scalar;
  part?: $Scalar;
  popover?: $Scalar;
  role?: $Scalar;
  spellcheck?: $Scalar;
  style?: $Scalar;
  tabindex?: $Scalar;
  title?: $Scalar;
  translate?: $Scalar;
  virtualkeyboardpolicy?: $Scalar;
  onabort?: $Scalar;
  onblur?: $Scalar;
  oncanplay?: $Scalar;
  oncanplaythrough?: $Scalar;
  onchange?: $Scalar;
  onclick?: $Scalar;
  oncontextmenu?: $Scalar;
  ondblclick?: $Scalar;
  ondrag?: $Scalar;
  ondragend?: $Scalar;
  ondragenter?: $Scalar;
  ondragleave?: $Scalar;
  ondragover?: $Scalar;
  ondragstart?: $Scalar;
  ondrop?: $Scalar;
  ondurationchange?: $Scalar;
  onemptied?: $Scalar;
  onended?: $Scalar;
  onerror?: $Scalar;
  onfocus?: $Scalar;
  onformchange?: $Scalar;
  onforminput?: $Scalar;
  oninput?: $Scalar;
  oninvalid?: $Scalar;
  onkeydown?: $Scalar;
  onkeypress?: $Scalar;
  onkeyup?: $Scalar;
  onload?: $Scalar;
  onloadeddata?: $Scalar;
  onloadedmetadata?: $Scalar;
  onloadstart?: $Scalar;
  onmousedown?: $Scalar;
  onmousemove?: $Scalar;
  onmouseout?: $Scalar;
  onmouseover?: $Scalar;
  onmouseup?: $Scalar;
  onmousewheel?: $Scalar;
  onmouseenter?: $Scalar;
  onmouseleave?: $Scalar;
  onpause?: $Scalar;
  onplay?: $Scalar;
  onplaying?: $Scalar;
  onprogress?: $Scalar;
  onratechange?: $Scalar;
  onreset?: $Scalar;
  onresize?: $Scalar;
  onreadystatechange?: $Scalar;
  onscroll?: $Scalar;
  onseeked?: $Scalar;
  onseeking?: $Scalar;
  onselect?: $Scalar;
  onshow?: $Scalar;
  onstalled?: $Scalar;
  onsubmit?: $Scalar;
  onsuspend?: $Scalar;
  ontimeupdate?: $Scalar;
  onvolumechange?: $Scalar;
  onwaiting?: $Scalar;
  onpointercancel?: $Scalar;
  onpointerdown?: $Scalar;
  onpointerenter?: $Scalar;
  onpointerleave?: $Scalar;
  onpointerlockchange?: $Scalar;
  onpointerlockerror?: $Scalar;
  onpointermove?: $Scalar;
  onpointerout?: $Scalar;
  onpointerover?: $Scalar;
  onpointerup?: $Scalar;
  'aria-activedescendant'?: $Scalar;
  'aria-atomic'?: $Scalar;
  'aria-autocomplete'?: $Scalar;
  'aria-busy'?: $Scalar;
  'aria-checked'?: $Scalar;
  'aria-colcount'?: $Scalar;
  'aria-colindex'?: $Scalar;
  'aria-colspan'?: $Scalar;
  'aria-controls'?: $Scalar;
  'aria-current'?: $Scalar;
  'aria-describedby'?: $Scalar;
  'aria-disabled'?: $Scalar;
  'aria-dropeffect'?: $Scalar;
  'aria-errormessage'?: $Scalar;
  'aria-expanded'?: $Scalar;
  'aria-flowto'?: $Scalar;
  'aria-grabbed'?: $Scalar;
  'aria-haspopup'?: $Scalar;
  'aria-hidden'?: $Scalar;
  'aria-invalid'?: $Scalar;
  'aria-label'?: $Scalar;
  'aria-labelledby'?: $Scalar;
  'aria-level'?: $Scalar;
  'aria-live'?: $Scalar;
  'aria-modal'?: $Scalar;
  'aria-multiline'?: $Scalar;
  'aria-multiselectable'?: $Scalar;
  'aria-orientation'?: $Scalar;
  'aria-owns'?: $Scalar;
  'aria-placeholder'?: $Scalar;
  'aria-posinset'?: $Scalar;
  'aria-pressed'?: $Scalar;
  'aria-readonly'?: $Scalar;
  'aria-relevant'?: $Scalar;
  'aria-required'?: $Scalar;
  'aria-roledescription'?: $Scalar;
  'aria-rowcount'?: $Scalar;
  'aria-rowindex'?: $Scalar;
  'aria-rowspan'?: $Scalar;
  'aria-selected'?: $Scalar;
  'aria-setsize'?: $Scalar;
  'aria-sort'?: $Scalar;
  'aria-valuemax'?: $Scalar;
  'aria-valuemin'?: $Scalar;
  'aria-valuenow'?: $Scalar;
  'aria-valuetext'?: $Scalar;
  'aria-details'?: $Scalar;
  'aria-keyshortcuts'?: $Scalar;
} & { [k: \`data-\${string}\`]: $Scalar } & { [k: \`aria-\${string}\`]: $Scalar };

declare function $text(v: $Scalar): void;
declare function $attr(v: $Scalar): void;
declare function $attrs<T>(a: T & $GlobalAttrs): void;

/**
 * The PROPS of a component host — what is written with a dot, and nothing else.
 *
 * Without \`$GlobalAttrs\`, and that is the whole of it (BUG-23 §2.1): the literal that
 * carries the props is the one the dot completes against, so intersecting it with HTML's
 * vocabulary made \`<app-badge .|>\` offer \`id\`, \`class\` and \`role\` beside the contract. A
 * plain attribute on the same host still goes to \`$attrs<{}>\`, which is HTML's vocabulary
 * and nothing else.
 */
declare function $props<T>(p: T): void;

/**
 * The type of an EMPTY position inside a start tag: \`<app-badge |>\`.
 *
 * Everything that may be written there, in ONE type, because the answer has to arrive in one
 * reply. A prop is written with a dot, so the key carries the dot — \`.tone\` and not \`tone\` —
 * and that is not decoration: it is what the developer types, and it is also what tells the two
 * families apart afterwards. TypeScript hands a key that is not an identifier back quoted, so
 * the props arrive as \`".tone"\` and HTML's vocabulary arrives bare, with no list kept anywhere
 * to say which is which.
 *
 * It repeals decision (b) of BUG-23 §4.0, which put HTML's vocabulary alone here and left the
 * contract behind the dot. Asking «what may go here?» and being answered \`id\`, \`class\`, \`role\`
 * is being answered the half you already knew: the props are the half that cannot be guessed.
 *
 * NOT the call that checks anything. The stretches mapped into it carry completion alone
 * (\`COMPLETION_ONLY_CAPS\`), every key is optional, and what a written attribute is checked
 * against stays \`$attrs\` — so this type can be generous without a single diagnostic depending
 * on it.
 */
declare function $gap<T>(a: { [K in keyof T & string as \`.\${K}\`]?: T[K] } & $GlobalAttrs): void;

/**
 * The REQUIRED keys of \`T\` that \`K\` does not name.
 *
 * \`-?\` strips optionality so \`Pick<T, K>\` can be compared against \`{}\`: a key that is
 * optional makes \`{}\` assignable, so it drops out and only what the author cannot forget
 * survives.
 */
type $RequiredKeys<T> = { [K in keyof T]-?: {} extends Pick<T, K> ? never : K }[keyof T];
type $Missing<T, K> = Pick<T, Exclude<$RequiredKeys<T>, K>>;

/**
 * Completeness, checked APART from the values (BUG-23 §2.1).
 *
 * \`TS2739\` over an object literal is reported on the whole argument — from the \`{\` to the
 * \`}\` — and both of those ends are scaffolding, so Volar mapped the error back nowhere and
 * the missing prop was never reported. Here the argument is a single stretch standing for the
 * tag NAME, which is where the author has to read it anyway.
 */
declare function $required<T, K extends PropertyKey>(rest: $Missing<T, K>): void;
declare function $on<K extends keyof HTMLElementEventMap>(
  type: K, h: (ev: HTMLElementEventMap[K]) => unknown): void;
declare function $section<T extends string>(name: T): void;
declare function $cls(v: boolean): void;
declare function $sty(v: string): void;
declare function $slot(): void;
declare function $intoSlot<T extends string>(name: T): void;
declare function $ref<E extends Element>(): E;

/**
 * \`control="@f.title"\` on a native element — the node the binding names, as CODE.
 *
 * It carries no type of its own, and that is the boundary SDD-34 §4.9 draws rather than an
 * omission. What the projection owes the author here is that the EXPRESSION is checked: a
 * misspelt member of the schema is a member access that does not resolve, and a name that was
 * never declared is \`TS2304\` — which is precisely why the emit was allowed to check shapes
 * and no types at all. What it does not yet owe is the shape of the element: that a
 * \`<select multiple>\` wants \`Control<readonly string[]>\` while an \`<input type="checkbox">\`
 * wants \`Control<boolean>\` is a fact about six bind functions, and stating it here would pull
 * \`@fudic/forms/dom\` into the projection of every file that opens an \`<input>\`.
 *
 * On a COMPONENT tag there is no call at all: the same binding is the \`ctrl\` prop
 * (decision 112), so it is checked inside the props literal, against the type the child
 * really declared.
 */
declare function $control(node: $ControlNode): void;

/**
 * \`control\` on a \`<form>\`, or on any element that is neither a form nor a field: what binds
 * there is a FORM or a GROUP, and \`bindForm\`/\`bindGroup\` take one.
 */
declare function $controlGroup(node: $FormNode): void;

/**
 * What a control looks like, structurally — the members of \`Control<T>\` that no other node has.
 *
 * Structural and not the real \`Control<T>\`, because the projection may not import
 * \`@fudic/forms\`: it would put a package dependency into the virtual file of every \`.fud\` that
 * opens an \`<input>\`, and a corpus with no forms installed would stop projecting at all. The
 * three members below are what \`bindText\` and the other five actually use, so the shape checked
 * here is the shape the emitted call needs.
 *
 * It is deliberately NOT parameterised by the value. Which \`Control<T>\` an element takes is the
 * fact its \`type\` states, and a dynamic \`type\` states it at runtime (decision 109) — so a rule
 * written here would be right for a static \`type\` and wrong for the component the dynamic one
 * exists to allow. What this catches is the mistake that is always a mistake: a form or a group
 * written where a field goes.
 */
type $ControlNode = { (): unknown; set(v: never): void; touch(): void };

/**
 * What a form or a group looks like: the \`$\` API of \`FormApi\`, which a \`Control<T>\` has none of.
 *
 * The two shapes are disjoint on purpose — a control is CALLABLE and a form is not — so the
 * error a mix-up produces names the member that is missing rather than a type nobody wrote.
 */
type $FormNode = { $touch(): void; $validate(...args: never[]): unknown };

/**
 * The node crossing \`control\` into a COMPONENT — checked against the \`ctrl\` the child declared.
 *
 * An identity with \`V\` passed EXPLICITLY, and it exists for where the error lands rather than
 * for what it says. A mismatch written straight into the props literal is reported over
 * \`ctrl: (…)\`, and those two ends live in two different stretches — the key is scaffolding the
 * author never typed — so Volar maps the range back nowhere and a correct error becomes no
 * error at all. As an argument the whole range is the author's own expression.
 *
 * Unlike \`$cross\`, there is no second branch to choose from: a node crosses as itself, always
 * (SDD-34 §4.6). What varies with the child is the TYPE it has to satisfy, not the form.
 */
declare function $node<V>(node: V): V;

/**
 * A value that crosses a \`.prop\` naming a reactive — the OBJECT, or its read (props-spec
 * decision 86).
 *
 * The build decides between the two by what the CHILD declares: a prop typed \`Signal<T>\` gets
 * the signal, one typed \`T\` gets \`name()\`. The projection cannot read the child's \`.fud\`, and
 * it does not have to — the child's contract is already imported as a type, so the question is
 * handed to the checker in the one shape that answers both at once. \`V\` is passed
 * EXPLICITLY, as the declared type of that very prop: inference from a union parameter would
 * pick the bare \`V\` branch and decide the object every time.
 *
 * That is the invariant of BUG-23 §5 kept under props-spec decision 86: where the emit transforms a
 * value before crossing it, the projection checks the same transformation — including the one
 * that transforms nothing.
 */
declare function $cross<V>(source: V | (() => V)): V;

/**
 * The declared type of ONE prop, as the value crossing into it has to satisfy it.
 *
 * Two corrections over a bare \`T[K]\`. The \`undefined\` an optional key carries is taken back
 * out: under \`exactOptionalPropertyTypes\` a \`tone?: Tone\` means «absent or Tone», so putting
 * \`Tone | undefined\` back into the literal is a \`TS2379\` about a value the author wrote
 * correctly. And a key the child does NOT declare falls back to \`unknown\` rather than to
 * \`never\`: that mistake is already reported once, on the key, and a second error about its
 * value would be the same mistake said twice.
 */
type $Prop<T, K extends PropertyKey> = K extends keyof T ? Exclude<T[K], undefined> : unknown;

/**
 * The identity of one iteration of a loop (BUG-17 §3.1).
 *
 * \`unknown\` on purpose. Offering is not validating: reconciliation keys a \`Map\`, and in a
 * \`Map\` object identity is a perfectly good key, so \`string | number\` would reject keys
 * that work. \`$key\` exists to open a scope to ask questions in, not to judge the answer.
 *
 * OPTIONAL for the same reason. A \`key (|)\` the author has not finished projects as an empty
 * argument, and that is the one moment the list is wanted; a required parameter would answer
 * it with \`TS2554\` about a stretch nobody typed. The clause being unfinished is already said,
 * once, by \`FUD0541\` — and the compiler is who owns that sentence.
 */
declare function $key(k?: unknown): void;

type $El<T extends string> = T extends keyof HTMLElementTagNameMap
  ? HTMLElementTagNameMap[T]
  : HTMLElement;
",
  "demo/fudic.json": "{
  "id": "demo",
  "kind": "app"
}
",
  "demo/package.json": "{
  "name": "demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fudic/core": "0.0.1",
    "@fudic/ssr": "0.0.1",
    "@fudic/transport": "0.0.1"
  },
  "devDependencies": {
    "@fudic/vite": "0.0.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  }
}
",
  "demo/src/layouts/_layout.fud": "<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    @* The main-thread bootstrap: it installs the hydration runtime -- always -- and
       registers the render Service Worker when the app was built with one. It lives here,
       once, so no route can forget it. Remove it and the page still paints, and nothing
       ever reacts to a click. *@
    <script type="module" src="/fudic-main.js"></script>

    @* Everything each route contributes to the head — its <title>, its component
       stylesheets, the style-adoption polyfill — is inserted exactly here. *@
    @RenderHead()
  </head>
  <body>

    <main>@RenderBody()</main>
  </body>
</html>
",
  "demo/src/routes/index.fud": "<link rel="layout" href="../layouts/_layout.fud">

<head>
  <title>Home</title>
</head>

<h1>Home</h1>
",
  "demo/sw.json": "{
  "shell": ["/fudic-main.js"],
  "resources": {
    "assets": {
      "pattern": "/assets/**",
      "policy": "cache-first",
      "ttl": null,
      "maxEntries": 200
    }
  },
  "dev": "off"
}
",
  "demo/tsconfig.json": "{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.fud", "fudic-globals.d.ts"]
}
",
  "demo/vite.config.ts": "import { defineConfig } from 'vite';
import { fudic } from '@fudic/vite';

// Nothing else to configure: the plugin discovers \`src/routes/\`, infers each route's
// mode, emits the route→chunk manifest and the bootstraps, and prerenders what it can.
export default defineConfig({
  plugins: [fudic()],
});
",
}
`;
