{
  "name": "@fudic/cli",
  "version": "0.0.1",
  "description": "fudic scaffolding CLI \u2014 creates projects and generates pages, components and layouts.",
  "type": "module",
  "license": "MIT",
  "author": "Pedro Hurtado",
  "homepage": "https://github.com/fudiePlatform/fudic/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fudiePlatform/fudic.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/fudiePlatform/fudic/issues"
  },
  "keywords": [
    "fudic",
    "fudie",
    "declarative-shadow-dom",
    "cli",
    "scaffolding"
  ],
  "bin": {
    "fudic": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fudic/compiler": "workspace:*",
    "@fudic/conventions": "workspace:*",
    "@fudic/formatter": "workspace:*",
    "@fudic/language-core": "workspace:*"
  },
  "devDependencies": {
    "@fudic/tsconfig": "workspace:*",
    "@fudic/vite": "workspace:*",
    "@types/node": "22.20.0",
    "vite": "8.0.16"
  }
}
