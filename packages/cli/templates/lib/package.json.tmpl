{
  "name": "{{name}}",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "src",
    "fudic.json"
  ],
  "exports": {
    "./fudic.json": "./fudic.json",
    "./*.fud": "./src/components/*/*.fud",
    "./*.fixture": "./src/components/*/*.fixture.ts",
    "./layouts/*.fud": "./src/layouts/*.fud",
    "./snippets/*.fud": "./src/snippets/*.fud",
    "./pipes/*": "./src/pipes/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "spec": "fudic-workbench run --pass-with-no-specs"
  },
  "peerDependencies": {
    "@fudic/core": "{{version}}"
  },
  "devDependencies": {
    "@fudic/cli": "{{version}}",
    "@fudic/core": "{{version}}",
    "@fudic/ssr": "{{version}}",
    "@fudic/terms": "{{version}}",
    "@fudic/testing": "{{version}}",
    "@fudic/vite": "{{version}}",
    "@fudic/workbench": "{{version}}",
    "vite": "{{viteVersion}}",
    "vitest": "{{vitestVersion}}"
  }{{uses}}
}
