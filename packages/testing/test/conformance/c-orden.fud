@* §3.5 bis: `toSorted` is stable and leaves the list as it was; a NaN of the comparator counts as 0; text is UTF-16. *@
@code {
  type Item = { n: string; p: number };

  const { xs = [] } = props<{ xs?: readonly Item[] }>();
}

<c-orden>
  <template shadowrootmode="open">
    <p class="estable">@(xs.toSorted((a, b) => a.p - b.p).map(x => x.n).reduce((s, x, i) => i === 0 ? x : `${s},${x}`, ""))</p>
    <p class="original">@(xs.map(x => x.n).reduce((s, x, i) => i === 0 ? x : `${s},${x}`, ""))</p>
    <p class="nan">@(xs.toSorted((a, b) => a.p * 0 / 0).map(x => x.n).reduce((s, x, i) => i === 0 ? x : `${s},${x}`, ""))</p>
    <p class="utf16">@("😀" < "～")</p>
    <p class="length">@("😀".length) @("hola".length)</p>
  </template>
</c-orden>
