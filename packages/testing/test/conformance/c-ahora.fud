@* §3.12: `now()` as the initializer of a signal; a date is painted only with a pipe. *@
@code {
  import { now, signal } from "@fudic/core";
  import { date } from "@fudic/i18n";

  const ahora = signal(now());
  const hora = date({ timeStyle: "medium", timeZone: "UTC" });
}

<c-ahora>
  <template shadowrootmode="open">
    <p>Son las <time>@(ahora() | hora)</time>.</p>
  </template>
</c-ahora>
