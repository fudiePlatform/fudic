@code {
  import { signal, now } from "@fudic/core";

  const ahora = signal(now());

  function later() {
    ahora.set(new Date(ahora().getTime() + 1000));
  }
}

<p61-clock>
  <template shadowrootmode="open">
    <time>@(ahora().toISOString())</time>
    <button @click=@later>+1s</button>
  </template>
</p61-clock>
