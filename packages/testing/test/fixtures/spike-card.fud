@code {
  import { signal } from "@fudic/core";

  const { label = "none" } = props<{ label?: string }>();

  const n = signal(0);
}

<head>
  <style>
    p { color: red; }
  </style>
</head>

<spike-card>
  <template shadowrootmode="open">
    <p>@label</p>
    <button @click=@(() => n.set(n() + 1))>@n()</button>
  </template>
</spike-card>
