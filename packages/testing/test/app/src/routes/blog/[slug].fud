<link rel="layout" href="../../layouts/_layout.fud">

@code {
  type PageData = { title: string; lang: string };

  @server {
    import { notFound } from "@fudic/http";
    import { findPost } from "../../data/posts";

    export async function load({ params }: { params: { slug: string } }): Promise<PageData> {
      const post = await findPost(params.slug);
      if (post === undefined) throw notFound(`no post "${params.slug}"`);
      return { title: post.title, lang: post.lang };
    }

    export function layout(ctx, data) {
      return { culture: data.lang };
    }
  }
}

<head>
  <title>@data.title — test</title>
</head>

@section nav {
  <a href="/">Home</a>
}

<h1>@data.title</h1>
