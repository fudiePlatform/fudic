<link rel="server" href="./x-save.fudapi">

@code {
  import { signal } from "@fudic/core";

  const state = signal("");

  async function go() {
    state.set(await save());
  }
}

<x-save>
  <template shadowrootmode="open">
    <button @click=@go>Save</button>
    <output role="status">@state()</output>
  </template>
</x-save>
