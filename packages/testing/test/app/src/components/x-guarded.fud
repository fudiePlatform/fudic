<link rel="server" href="./x-guarded.fudapi">

@code {
  import { signal } from "@fudic/core";

  const who = signal("");

  async function ask() {
    who.set(await whoami());
  }
}

<x-guarded>
  <template shadowrootmode="open">
    <button @click=@ask>Who</button>
    <output role="status">@who()</output>
  </template>
</x-guarded>
