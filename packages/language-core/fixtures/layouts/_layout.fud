<!DOCTYPE html>
<html lang="@culture" data-theme="@theme">
  <head>
    @code {
      const { culture, theme = "light" } = props<{ culture: string; theme?: string }>();
    }
    <meta charset="utf-8">
    @RenderHead()
  </head>
  <body>
    <header>
      @RenderSection(nav)
    </header>
    <main>
      @RenderBody()
    </main>
  </body>
</html>
