{
  "extends": "@fudic/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "paths": {
      "@fudic/di": ["../di/src/index.ts"],
      "@fudic/dom": ["../dom/src/index.ts"]
    }
  },
  // `url.ts` of @fudic/dom, reached by source through `paths`, reads `import.meta.env`.
  "include": ["src", "test", "../dom/src/env.d.ts"]
}
