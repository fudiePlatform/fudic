@code {
  type Row = { name: string; next?: Row };

  const { first = { name: "Ada" } } = props<{ first?: Row }>();
}

<app-rows>
  <template shadowrootmode="open">
    @render fila(@first)
  </template>
</app-rows>

@snippet fila(f: Row) {
  <p>@f.name</p>
  @if (f.next) { @render fila(@f.next) }
}
