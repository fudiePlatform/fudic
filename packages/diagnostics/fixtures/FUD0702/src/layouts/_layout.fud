<!DOCTYPE html>
<html lang="en">
  <head>
    @code {
      const { section } = props<{ section: string }>();
    }

    <meta charset="utf-8">
    <meta property="article:section" content="@section">
    <script type="module" src="fudic:runtime"></script>
    @RenderHead()
  </head>
  <body>
    <main>@RenderBody()</main>
  </body>
</html>
