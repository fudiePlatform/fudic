<link rel="server" href="../forms/f.fudapi">

@code {
  const { hint } = props<{ hint: boolean }>();
}

<app-form>
  <template shadowrootmode="open">
    <form control=@f>
      <input control=@f.title type="text">
      @if (hint) {
        <span error=@f.title></span>
      }
    </form>
  </template>
</app-form>
