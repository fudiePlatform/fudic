{
  "name": "@fudic/http",
  "version": "0.0.1",
  "description": "Server functions and middlewares for fudic — named functions the client calls by name, one chain of two-sided middlewares, and errors as exceptions.",
  "type": "module",
  "license": "MIT",
  "author": "Pedro Hurtado",
  "homepage": "https://github.com/fudiePlatform/fudic/tree/main/packages/http#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fudiePlatform/fudic.git",
    "directory": "packages/http"
  },
  "bugs": {
    "url": "https://github.com/fudiePlatform/fudic/issues"
  },
  "keywords": [
    "fudic",
    "fudie",
    "http",
    "rpc",
    "middleware",
    "server-functions"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./contract/server": {
      "types": "./dist/contract/server.d.ts",
      "import": "./dist/contract/server.js"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js"
    },
    "./wire/bin": {
      "types": "./dist/wire/bin.d.ts",
      "import": "./dist/wire/bin.js"
    },
    "./wire/json": {
      "types": "./dist/wire/json.d.ts",
      "import": "./dist/wire/json.js"
    },
    "./wire/vectors.json": "./wire/vectors.json",
    "./package.json": "./package.json"
  },
  "fudic": {
    "runtime": "./runtime"
  },
  "sideEffects": ["./browser/**", "./server/**"],
  "files": [
    "dist",
    "runtime",
    "fudapi",
    "browser",
    "server",
    "wire",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.impl.json && pnpm run build:runtime",
    "build:runtime": "node -e \"require('node:fs').rmSync('runtime',{recursive:true,force:true})\" && rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fudic/conventions": "workspace:*",
    "@fudic/di": "workspace:*",
    "@fudic/forms": "workspace:*"
  },
  "devDependencies": {
    "@fudic/tsconfig": "workspace:*",
    "rolldown": "1.2.1"
  }
}
