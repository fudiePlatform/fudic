<link rel="layout" href="../../layouts/_layout.fud">
<link rel="component" href="../../components/site-nav.fud">
<link rel="component" href="../../components/app-badge.fud">
<link rel="server" href="./[slug].fudapi">

@code {
  type PageData = { title: string; tag: string; body: string; found: boolean };
}

<head>
  <title>@data.title — fudic</title>
</head>

@section nav {
  <site-nav current="blog"></site-nav>
}

<article>
  <app-badge tone="@(data.found ? 'info' : 'neutral')">@data.tag</app-badge>
  <h1>@data.title</h1>
  <p>@data.body</p>
  @if (data.found) {
    <p class="note">
      Este HTML lo escribió el build porque <code>paths()</code> enumeró el slug.
    </p>
  } else {
    <p class="note">
      Este slug no estaba en <code>paths()</code>: lo ha renderizado el Service
      Worker en el momento de la navegación (fallback <code>lazy</code>).
    </p>
  }
  <p><a href="/blog">← volver al blog</a></p>
</article>
