@code {
  type Variant = 'primary' | 'ghost';

  const { variant = 'primary', disabled = false } = props<{ variant?: Variant; disabled?: boolean }>();

  @client {
    import { emit } from '@fudic/dom';

    // `emit` forces `bubbles` and `composed`, and the compiler injects the host as its
    // `this`. Finding that host by hand with `closest('app-button')` was exactly what
    // this primitive exists so nobody has to write.
    function onClick() {
      emit('press');
    }
  }
}

<head>
  <style>
    :host { display: inline-block; }
    .btn {
      font: inherit;
      padding: 0.5rem 1rem;
      border: 1px solid currentColor;
      border-radius: 6px;
      cursor: pointer;
      background: transparent;
    }
    .btn.primary { background: #1a73e8; color: white; border-color: #1a73e8; }
    .btn.ghost { color: #1a73e8; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  </style>
</head>

<app-button>
  <template shadowrootmode="open">
    <button
      class="btn"
      class:primary="@(variant === 'primary')"
      class:ghost="@(variant === 'ghost')"
      disabled="@disabled"
      @click="@onClick">
      <slot></slot>
    </button>
  </template>
</app-button>
