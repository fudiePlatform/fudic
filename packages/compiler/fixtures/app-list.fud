@code {
  type Row = { id: string; label: string; tags: string[] };

  const { rows = [], empty = 'Sin elementos' } = props<{ rows?: Row[]; empty?: string }>();
}

<head>
  <style>
    :host { display: block; }
    .list { margin: 0; padding: 0; list-style: none; }
    .row { display: flex; gap: 0.5rem; align-items: baseline; }
    .tag { font-size: 0.7rem; color: #666; }
    .empty { color: #888; font-style: italic; }
  </style>
</head>

<app-list>
  <template shadowrootmode="open">
    <ul class="list">
      @foreach (const row of rows) key (row.id) {
        <li class="row">
          <span>@row.label</span>
          @foreach (const mark of row.tags) key (mark) {
            <span class="tag">@mark</span>
          }
        </li>
      } @empty {
        <li class="empty">@(empty)</li>
      }
    </ul>
  </template>
</app-list>
