<link rel="component" href="./app-button.fud">

@code {
  type Variant = 'default' | 'highlight';

  const { title, variant = 'default' } = props<{ title: string; variant?: Variant }>();

  @client {
    import { signal } from '@fudic/core';

    const expanded = signal(false);

    function toggle() {
      expanded.set(!expanded());
    }
  }
}

<head>
  <style>
    :host { display: block; }
    .card {
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 1rem;
      .body { margin-top: 0.5rem; }
    }
    .card.highlight { border-color: gold; }
  </style>
</head>

<app-card>
  <template shadowrootmode="open">
    <article class="card" class:highlight="@(variant === 'highlight')">
      <header>
        <h2>@title</h2>
      </header>
      @if (expanded()) {
        <div class="body">
          <slot></slot>
        </div>
      }
      <app-button .variant="ghost" @press="@toggle">
        @if (expanded()) { Cerrar } else { Abrir }
      </app-button>
    </article>
  </template>
</app-card>
