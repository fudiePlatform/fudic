import { minLength, pattern } from "fudic:@fudic/forms/rules";

export const sloppy = formOf({
  note: str(""),
  pick: arr(str, []),
  word: str("", [minLength.use(), pattern.use({ regex: undefined }), pattern.use({ regex: 5 })], { messages: { pattern: text("t") } }),
  plain: group({
    x: str(""),
  }, []),
}, [], { validateOn: 1 });
export const load = page({ id: "routes/sloppy", name: "load", chain: [{ steps: [] }], browser: true });
export const LoadFails = fails({ gone: [410] });
export const odd = stub({ id: "routes/sloppy", name: "odd", method: "GET", args: { thing: "str", grid: { list: { list: "str" } }, loose: { map: ["str", { opt: "str" }] } }, chain: [{ steps: [{ use: [] }], compress: { format: "gzip" } }] });
"
