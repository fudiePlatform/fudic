exports[`the corners, as text > routes/shop: the .d.ts and both variants > browser 1`] = `
"// Generated by fudic from routes/shop.fudapi (browser). Do not edit.
import { page, stub, use } from '@fudic/http/contract';
import { arr, bool, compare, date, f64, formOf, group, i32, isEmpty, lengthOf, requireOn, requireRule, same, str, text, uuid, validAt } from '@fudic/forms/contract';
import { minLength, required } from "fudic:@fudic/forms/rules";
import { anyList, anyValue, dated, stamp, tagger, whole } from "fudic:ext/rules";

export const shop = formOf({
  tags: arr(str, [], [anyList.use(), minLength.use({ n: 1 })], { messages: { minLength: text("Al menos {n}.") } }),
  day: date(new Date("2026-01-01"), [dated.use()]),
  since: date(null, [requireOn("later", [], (v, root) => compare(v.since, ">", v.day))]),
  qty: i32(null, [anyValue.use()], { messages: { range: text("Entre -2147483648 y 2147483647.") }, validateOn: 2, validity: 1 }),
  price: f64(null, [], { messages: { range: text("Un precio: .") } }),
  id: uuid("", [], { messages: { uuid: text("No es un identificador.") } }),
  sure: bool(false),
  box: group({
    a: i32(null, [required.use()]),
    b: i32(null, [requireOn("ordered", ["box"], (v, root) => compare(v.a, "<", v.b))], { messages: { ordered: text("a va antes que b") } }),
  }, [requireRule("positive", (v, root) => !(validAt(root, ["box","a"])) || (compare(v.a, ">", 0)))], { validateOn: 1, validity: 0 }),
}, [whole.use(), requireRule("some", (v, root) => !((isEmpty(v.tags) && same(lengthOf(v.tags), 0)))), requireRule("sized", (v, root) => ((compare(v.qty, "<=", 10) || (compare(v.qty, ">=", 100) && compare(v.qty, ">", 5))) || compare(1, ">=", v.qty))), requireRule("named", (v, root) => ((!same(v.box.a, 3) && same("x", "x")) && same(v.sure, true)))], { messages: { some: text("Algo.") }, validateOn: 0, validity: 0 });
export const paths = page({ id: "routes/shop", name: "paths", browser: true });
export const layout = page({ id: "routes/shop", name: "layout", browser: true });
export const list = stub({ id: "routes/shop", name: "list", method: "GET", chain: [{ steps: [{ use: [use(tagger, { tags: ["a", "b"] })] }, { use: [use(tagger, { tags: [], limit: 3 })] }, { use: [use(stamp)] }, { use: [] }, { skip: [] }] }] });
export const buy = stub({ id: "routes/shop", name: "buy", method: "POST", chain: [{ steps: [] }] });
export const order = stub({ id: "routes/shop", name: "order", method: "POST", form: shop, chain: [{ steps: [] }] });
"
`;

exports[`the corners, as text > routes/shop: the .d.ts and both variants > d.ts 1`] = `
"// Generated by fudic from routes/shop.fudapi. Do not edit.
declare module "fudic:routes/shop" {
  import type { Contract, FnContext, FormContext, PageContext, PagePiece } from '@fudic/http/contract';
  import type { Bool, DateField, Form, List, Num, Str, Validated } from '@fudic/forms/contract';

  export const shop: Form<{ tags: List<string>; day: DateField; since: DateField; qty: Num; price: Num; id: Str; sure: Bool; box: Form<{ a: Num; b: Num }> }>;
  export type ShopValue = { readonly tags: readonly string[]; readonly day: Date | null; readonly since: Date | null; readonly qty: number | null; readonly price: number | null; readonly id: string; readonly sure: boolean; readonly box: { readonly a: number; readonly b: number | null } };

  export type ListCtx = FnContext<{}, {}, undefined> & import("fudic:ext/rules").StampAdds;
  export type ListHandler = (ctx: ListCtx) => string | undefined | Promise<string | undefined>;
  export const list: Contract<ListCtx, string | undefined, void>;

  export type BuyCtx = FnContext<{}, {}, undefined>;
  export type BuyHandler = (ctx: BuyCtx) => void | Promise<void>;
  export const buy: Contract<BuyCtx, void, void>;

  export type OrderCtx = FormContext<{}, {}, Validated<typeof shop, ShopValue>>;
  export type OrderHandler = (ctx: OrderCtx) => Readonly<Record<number, string>> | Promise<Readonly<Record<number, string>>>;
  export const order: Contract<OrderCtx, Readonly<Record<number, string>>, typeof shop>;

  export type PathsHandler = () => readonly string[] | Promise<readonly string[]>;
  export const paths: PagePiece<PathsHandler>;

  export type LayoutHandler = (ctx: PageContext<{}>, data: undefined) => Readonly<Record<string, unknown>> | Promise<Readonly<Record<string, unknown>>>;
  export const layout: PagePiece<LayoutHandler>;
}
"
`;

