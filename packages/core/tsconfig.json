{
  "extends": "@fudic/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "paths": {
      "@fudic/dom": ["../dom/src/index.ts"]
    }
  },
  // `bundle` is not built into `dist`, but is typechecked here so its `install` contract
  // holds. `env.d.ts` types the `import.meta.env` that @fudic/dom's `url.ts` reads.
  "include": ["src", "test", "bundle", "../dom/src/env.d.ts"]
}
