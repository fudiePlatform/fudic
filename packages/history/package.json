{
  "name": "@fudic/history",
  "version": "0.0.1",
  "description": "The history of each fudic piece: a `.fudlog` next to its `.fud`, in git and append-only, with who approved its criteria, every run of its tests and criteria, and the hashes that say whether they still hold.",
  "type": "module",
  "license": "MIT",
  "author": "Pedro Hurtado",
  "homepage": "https://github.com/fudiePlatform/fudic/tree/main/packages/history#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fudiePlatform/fudic.git",
    "directory": "packages/history"
  },
  "bugs": {
    "url": "https://github.com/fudiePlatform/fudic/issues"
  },
  "keywords": [
    "fudic",
    "fudie",
    "fudlog",
    "history"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fudic/api": "workspace:*",
    "@fudic/compiler": "workspace:*",
    "@fudic/conventions": "workspace:*",
    "@fudic/diagnostics": "workspace:*",
    "@fudic/spec": "workspace:*",
    "@fudic/typecheck": "workspace:*"
  },
  "devDependencies": {
    "@fudic/core": "workspace:*",
    "@fudic/dom": "workspace:*",
    "@fudic/ssr": "workspace:*",
    "@fudic/terms": "workspace:*",
    "@fudic/testing": "workspace:*",
    "@fudic/tsconfig": "workspace:*",
    "@fudic/workbench": "workspace:*",
    "@types/node": "22.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
