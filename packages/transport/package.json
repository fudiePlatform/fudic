{
  "name": "@fudic/transport",
  "version": "0.0.1",
  "description": "Three-thread client transport shell for fudic — a UI framework based on Declarative Shadow DOM.",
  "type": "module",
  "license": "MIT",
  "author": "Pedro Hurtado",
  "homepage": "https://github.com/fudiePlatform/fudic/tree/main/packages/transport#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fudiePlatform/fudic.git",
    "directory": "packages/transport"
  },
  "bugs": {
    "url": "https://github.com/fudiePlatform/fudic/issues"
  },
  "keywords": [
    "fudic",
    "fudie",
    "declarative-shadow-dom",
    "service-worker",
    "web-worker",
    "streaming"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "fudic": {
    "runtime": "./runtime"
  },
  "files": [
    "dist",
    "runtime",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:runtime",
    "build:runtime": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@fudic/ssr": "workspace:*",
    "@fudic/tsconfig": "workspace:*",
    "rolldown": "1.2.1"
  }
}
