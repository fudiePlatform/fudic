{
  "name": "@fudic/server",
  "version": "0.0.1",
  "description": "Serves a fudic app from a Request to a Response — pages, data, functions, error pages — the same in dev, in preview and behind any adapter.",
  "type": "module",
  "license": "MIT",
  "author": "Pedro Hurtado",
  "homepage": "https://github.com/fudiePlatform/fudic/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fudiePlatform/fudic.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/fudiePlatform/fudic/issues"
  },
  "keywords": [
    "fudic",
    "fudie",
    "server",
    "adapter",
    "ssr"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "node": ["./dist/node/index.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fudic/conventions": "workspace:*",
    "@fudic/http": "workspace:*",
    "@fudic/transport": "workspace:*"
  },
  "devDependencies": {
    "@fudic/tsconfig": "workspace:*",
    "@types/node": "22.20.0"
  }
}
