<link rel="layout" href="../layouts/_layout.fud">
<link rel="server" href="./blog.fudapi">
<head>
  <title>@data.title</title>
</head>

<h1>@data.title</h1>
<ul>
  @foreach (const post of data.posts) key (post.slug) {
    <li>@post.title <a href=@("/blog?tag=" + post.tag)>@post.tag</a></li>
  } @empty {
    <li>No posts with that tag.</li>
  }
</ul>
