<link rel="layout" href="../layouts/_layout.fud">
<link rel="server" href="./index.fudapi">

@code {
  import { date, list } from "@fudic/core";
  import initials from "../pipes/initials";

  const day = date({ dateStyle: "long", timeZone: "Europe/Madrid" });
  const tags = list();
}

<head>
  <title>@data.title</title>
</head>

<h1>@data.title</h1>
<p><span class="avatar">@(data.author | initials)</span> By @data.author, on @(data.published | day)</p>
<p>Tags: @(data.tags | tags)</p>
