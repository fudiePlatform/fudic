@code {
  let dialog: HTMLDialogElement | null = null;

  function open() {
    dialog?.showModal();
  }
}

<myapp-confirm>
  <template shadowrootmode="open" shadowrootadoptedstylesheets="button dialog p">
    <button type="button" @click=@open>Delete account</button>
    <dialog ref="@dialog">
      <p>Delete your account? This cannot be undone.</p>
      <form method="dialog">
        <button>Cancel</button>
      </form>
    </dialog>
  </template>
</myapp-confirm>
