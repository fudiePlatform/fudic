<link rel="layout" href="../layouts/_layout.fud">
<link rel="server" href="./index.fudapi">

<head>
  <title>Home</title>
</head>

<h1>Newsletter</h1>

<form control=@subscribeForm form:=@subscribe>
  <label for="email">Email</label>
  <input id="email" type="email" control=@subscribeForm.email>
  <small error=@subscribeForm.email></small>
  <button type="submit">Subscribe</button>
</form>
