{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git worktree add:*)",
      "PowerShell(git worktree list:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm coverage:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm -r:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm vitest:*)",
      "PowerShell(pnpm install:*)",
      "PowerShell(pnpm typecheck:*)",
      "PowerShell(pnpm test:*)",
      "PowerShell(pnpm build:*)",
      "PowerShell(pnpm coverage:*)",
      "PowerShell(pnpm run:*)",
      "PowerShell(pnpm -r:*)",
      "PowerShell(pnpm --filter:*)",
      "PowerShell(pnpm exec:*)",
      "PowerShell(pnpm vitest:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(pnpm publish:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -fdx:*)",
      "PowerShell(pnpm publish:*)"
    ]
  }
}
