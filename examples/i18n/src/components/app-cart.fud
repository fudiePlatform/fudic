@* Hydrated: its chunk is compiled once per locale, and the plural the catalogs write for the
   text and the price are formatted again in the browser with the runtime pieces of `@fudic/i18n`. *@
@code {
  import { currency } from '@fudic/i18n';

  const euros = currency('EUR');

  import { signal } from "@fudic/core";

  const n = signal(0);

  function mas(): void {
    n.set(n() + 1);
  }
}

<app-cart>
  <template shadowrootmode="open">
    <button @click=@mas>Añadir un café</button>
    <p>@n() cafés en el carrito</p>
    <p>Total: @(n() * 1.2 | euros)</p>
  </template>
</app-cart>
