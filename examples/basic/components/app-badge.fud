@code {
  type Tone = "neutral" | "success" | "info";

  const { tone = "neutral" } = props<{ tone?: Tone }>();
}

<head>
  <style>
    :host {
      display: inline-block;
    }
    .badge {
      font-size: 0.72rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      padding: 0.18rem 0.55rem;
      border: 1px solid #ccc;
      border-radius: 999px;
      background: #f3f3f3;
      color: #444;
    }
    .badge.success {
      background: #e6f4ea;
      border-color: #34a853;
      color: #1e7e34;
    }
    .badge.info {
      background: #e8f0fe;
      border-color: #1a73e8;
      color: #174ea6;
    }
  </style>
</head>

<app-badge>
  <template shadowrootmode="open">
    <span
      class="badge"
      class:success="@(tone === 'success')"
      class:info="@(tone === 'info')">
      <slot></slot>
    </span>
  </template>
</app-badge>
