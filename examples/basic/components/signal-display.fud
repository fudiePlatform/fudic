@code {
  // The child of the reference demo: what it receives IS the signal, so it reads the
  // value itself. The default keeps SSR alive while the prop pass does not exist.
  const { value = () => 0 } = props<{ value?: () => number }>();
}

<head>
  <style>
    :host {
      display: block;
    }
    .out {
      margin: 0;
      padding: 0.75rem 0.9rem;
      border: 1px dashed #34a853;
      border-radius: 8px;
      background: #f2f9f4;
      font-variant-numeric: tabular-nums;
      strong {
        font-size: 1.35rem;
      }
    }
    .what {
      margin: 0.5rem 0 0;
      font-size: 0.78rem;
      color: #1e7e34;
    }
  </style>
</head>

<signal-display>
  <template shadowrootmode="open">
    <p class="out">Valor leído por el hijo: <strong>@(value())</strong></p>
    <p class="what">Este hijo tiene la signal. Se lee solo.</p>
  </template>
</signal-display>
