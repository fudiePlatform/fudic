@code {
  // The child of the value demo: a plain number, nothing reactive of its own. It cannot
  // read a newer value — there is nothing to read from. Somebody has to write it in.
  // The default keeps SSR alive while the prop pass does not exist.
  const { value = 0 } = props<{ value?: number }>();
}

<head>
  <style>
    :host {
      display: block;
    }
    .out {
      margin: 0;
      padding: 0.75rem 0.9rem;
      border: 1px dashed #d93025;
      border-radius: 8px;
      background: #fdf3f2;
      font-variant-numeric: tabular-nums;
      strong {
        font-size: 1.35rem;
      }
    }
    .what {
      margin: 0.5rem 0 0;
      font-size: 0.78rem;
      color: #a50e0e;
    }
  </style>
</head>

<value-display>
  <template shadowrootmode="open">
    <p class="out">Valor recibido por el hijo: <strong>@value</strong></p>
    <p class="what">Este hijo no tiene nada reactivo. Alguien tiene que escribirle.</p>
  </template>
</value-display>
