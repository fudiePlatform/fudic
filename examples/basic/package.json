{
  "name": "@fudic/example-basic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Basic fudic example — filesystem routing, static + incremental SSG, zero-JS Declarative Shadow DOM.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:nosw": "vite build --config nosw/vite.config.ts",
    "preview:nosw": "vite preview --config nosw/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:spec": "fudic-workbench run",
    "test:e2e": "vite build && vite build --config nosw/vite.config.ts && playwright test",
    "test:e2e:trace": "playwright test -g trace"
  },
  "dependencies": {
    "@fudic/core": "workspace:*",
    "@fudic/di": "workspace:*",
    "@fudic/dom": "workspace:*",
    "@fudic/forms": "workspace:*",
    "@fudic/http": "workspace:*",
    "@fudic/i18n": "workspace:*",
    "@fudic/ssr": "workspace:*",
    "@fudic/transport": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fudic/terms": "workspace:*",
    "@fudic/testing": "workspace:*",
    "@fudic/vite": "workspace:*",
    "@fudic/workbench": "workspace:*",
    "@playwright/test": "1.62.0",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
