# Per request: the list changes with every new person, and a prerendered page would not see it.
# The session too: the value of its cookie as it came, or none — a fake one included.
load ssr
  users    Person[]
  session  str?

# Signs in as `user`: sets the session cookie, whoever it names. The next protected call says
# whether the server knows it. The page asks for its `data` again: it says who is in.
post login
  invalidates /usuarios
  user  str

# Signs out: the session cookie goes, and the page asks for its `data` again.
post logout
  invalidates /usuarios

# Public: searching needs no session. A longer text is refused in the browser, before it leaves.
get search
  q  str
    max-length 80
  -> Person[]

# The same search for a client that is not a fudic page: JSON in and out.
get searchJson
  use json
  q  str
    max-length 80
  -> Person[]

# The same search, three seconds late: time to cancel it.
get slowSearch
  q  str
  -> Person[]

# Turns a person on or off. A 409 is the page's to paint: `catches` keeps it there.
put save
  use auth
  catches 409
  fails ana 409 "A Ana no se la puede desactivar."
  id      i32
  active  bool

delete remove
  use auth audit
  id  i32

# The photo of a person, as a file: the table paints it with `<img src=@avatar.url(…)>`, and
# the browser asks for it with no script. Nobody's photo: a 204.
get avatar
  id  i32
  -> file?

# The table as a CSV, for a link with `download`.
get exportar
  -> file

# A failure nobody catches: error-pages takes the page to _error.fud with a 500.
get crash
  -> str

type Person
  id      i32
  name    str
  email   str
  age     u8
  active  bool
  notes   str
  # Whether `avatar` has a photo of this person.
  avatar  bool
