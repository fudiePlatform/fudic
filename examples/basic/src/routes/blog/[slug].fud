<link rel="layout" href="../../layouts/_layout.fud">
<link rel="component" href="../../components/site-nav.fud">
<link rel="component" href="../../components/app-badge.fud">

@code {
  type PageData = { title: string; tag: string; body: string; found: boolean; lang: string };

  @server {
    import { findPost, listSlugs } from "../../data/posts";

    export async function load({ params }: { params: { slug: string } }): Promise<PageData> {
      const post = await findPost(params.slug);
      if (post === undefined) {
        return {
          title: "Artículo no encontrado",
          tag: "404",
          body: `No hay ningún artículo con el slug "${params.slug}".`,
          found: false,
          lang: "es",
        };
      }
      return { title: post.title, tag: post.tag, body: post.body, found: true, lang: post.lang };
    }

    export async function paths(): Promise<string[]> {
      return [...(await listSlugs())];
    }

    // The layout's props, resolved AFTER `load` and out of what it brought. The culture of
    // this page is nowhere in its URL: it is a column of the row. Two slugs prerendered by
    // the same build come out with two different `<html lang>` because their posts are in
    // two different languages — which is the whole evidence of SDD-40.
    export function layout(ctx: unknown, data: PageData) {
      return { culture: data.lang };
    }
  }
}

<head>
  <title>@data.title — fudic</title>
</head>

@section nav {
  <site-nav .current="blog"></site-nav>
}

<article>
  <app-badge .tone=@(data.found ? 'info' : 'neutral')>@data.tag</app-badge>
  <h1>@data.title</h1>
  <p>@data.body</p>
  @if (data.found) {
    <p class="note">
      Este HTML lo escribió el build porque <code>paths()</code> enumeró el slug.
    </p>
  } else {
    <p class="note">
      Este slug no estaba en <code>paths()</code>: lo ha renderizado el Service
      Worker en el momento de la navegación (fallback <code>lazy</code>).
    </p>
  }
  <p><a href="/blog">← volver al blog</a></p>
</article>
