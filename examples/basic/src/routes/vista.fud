<link rel="layout" href="../layouts/_layout.fud">
<link rel="component" href="../components/site-nav.fud">
<link rel="component" href="../components/app-card.fud">
<link rel="component" href="../components/vista-tareas.fud">
<link rel="component" href="../components/vista-url.fud">
<link rel="server" href="./vista.fudapi">

@code {
  // SDD-61 — lo que se PUEDE escribir en la vista: la lista blanca que el compilador baja con
  // la misma semántica a TS, C#, Java, Go, Rust y Python. Cada caso de esta ruta dice «sin
  // diagnóstico», y la ruta entera compila sin uno solo. Lo que NO se puede está en
  // `examples/vista-errores/vista-errores.fud`, fuera de este proyecto para que `pnpm build`
  // siga construyendo.
  //
  // Esto es el corte de servidor: lo que la vista lee, y cada declaración tiene una forma que
  // el servidor de cualquier backend sabe evaluar.
  import type { Nodo } from "fudic:components/signal-while";
  import { trustedUrl } from "@fudic/dom";
  import { currency, t } from "@fudic/i18n";
  import { count } from "../store/contador";
  import pasos from "../data/pasos";

  // `const` y `let` con un valor de la lista.
  const prop1 = 2;
  const prop2 = 3;
  const ok = true;
  const si = true;
  const no = false;
  const id = 42;
  const nombre: string = "Ana";
  const texto = "hola, vista";
  const precio = 1234.5;
  let total = 0;

  // Una lista de primitivos es un literal de datos sin nombre.
  const valores = [1, 2, 3, 4];

  // Un objeto literal necesita un tipo con nombre del contrato.
  const raiz: Nodo = { id: "a", n: 1, next: { id: "b", n: 2, next: { id: "c", n: 3 } } };

  // El cursor del `@while`: un `@while` no declara variable, así que la suya vive aquí y el
  // template la resiembra antes de cada pasada.
  let cur: Nodo | undefined = raiz;

  // Llamadas del catálogo: un preset de pipe y la marca de una URL que el autor avala.
  const euros = currency("EUR");
  const abrir = trustedUrl("miapp:abrir");

  // ── URLs ──
  // Una imagen de 1×1 en `data:image/…`: pasa en `<img src>` y en ningún otro sitio.
  const png =
    "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg==";

  // Lo que el prefijo fijo NO fija: el valor va por el guardia aunque al final pase.
  const base = "https://cdn.example.com";
  const otroHost = "/evil.example";
  const malicioso = "javascript:alert('xss')";

  // `srcset` es una lista: cada candidato pasa por el guardia, y uno malo deja inerte el todo.
  const srcsetBueno = "/a.png 1x, /b.png 2x";
  const srcsetMalo = "/a.png 1x, javascript:alert('xss') 2x";
}

<head>
  <title>Lo que se escribe en la vista — fudic</title>
  <style>
    .caso {
      display: grid;
      grid-template-columns: 14rem 1fr;
      gap: 0.6rem;
      align-items: baseline;
      padding: 0.25rem 0;
      border-bottom: 1px solid var(--line);
    }
    .caso code {
      overflow-wrap: anywhere;
    }
    .punto {
      width: 16px;
      height: 16px;
      border: 1px solid var(--line);
    }
  </style>
</head>

@section nav {
  <site-nav .current="vista"></site-nav>
}

<h1>Lo que se escribe en la vista</h1>
<p>
  La vista rellena huecos, no programa: lo que se escribe en <code>@@( )</code>, en
  <code>@@{ }</code>, en un valor de atributo o en una cabecera de control es una lista blanca
  cerrada que el compilador baja igual a cualquier backend. Todo lo de esta página está en esa
  lista y compila sin un solo diagnóstico.
</p>

<h2>Valores y nombres</h2>
@* Literales de texto, numéricos en cualquier notación, lógicos y ausentes. Sin diagnóstico. *@
<p>Literales: @("activo") · @(3.5) @(1e3) @(0x10) @(1_000) · @(true) @(false) · [@(null)]</p>
@* `undefined` es el único global. Sin diagnóstico. *@
<p>Presencia: @(data.articulos[0]?.coautor === undefined)</p>
@* Un nombre del `@code`, de `data` o del template. Sin diagnóstico. *@
<p>Nombres: @nombre · @data.articulos.length artículos</p>

<h2>Operadores</h2>
@* Aritmética de `f64`: `+`, `-`, `*`, `/`, `%` con el signo del dividendo, y `-` unario. Sin diagnóstico. *@
<p>Aritmética: @(prop1 + prop2) · @(prop1 - prop2) · @(prop1 * prop2) · @(prop2 / prop1) · @(-7 % 3) · @(-prop1)</p>
@* `+` con un texto concatena, y el número pasa a texto como en JS. Sin diagnóstico. *@
<p>Concatenar: @("id " + id) · @(nombre + " y Luis")</p>
@* Igualdad entre primitivos del mismo tipo. Sin diagnóstico. *@
<p>Igualdad: @(prop1 === 2) · @(nombre !== "Luis")</p>
@* Relacionales entre dos números y entre dos textos, unidad a unidad UTF-16. Sin diagnóstico. *@
<p>Relacionales: @(prop1 < prop2) · @(prop1 >= prop2) · @("Z" < "a") · @("ab" <= "abc")</p>
@* Lógicos sobre booleanos, ternario y `??`. Sin diagnóstico. *@
<p>Lógicos: @(si && no) · @(si || no) · @(!ok) · @(ok ? "sí" : "no") · @(data.articulos[1]?.autor.web ?? "sin web")</p>
@* El pipe de un preset del catálogo, y paréntesis. Sin diagnóstico. *@
<p>Pipe: @(precio | euros) · @((prop1 + prop2) * 2)</p>

<h2>Llamadas</h2>
@* Leer un valor reactivo, aquí un store del proyecto. Sin diagnóstico. *@
<p>Store: @count()</p>
@* `t()` como valor de una prop. Sin diagnóstico. *@
<app-card .title=@t("Una tarjeta traducible") .href="/blog"></app-card>

<h2>Acceso y texto</h2>
@* Campo, campo opcional, índice de una lista y clave de un `map`; fuera de rango y una clave que no está dan «ausente». Sin diagnóstico. *@
<p>Campo: @(data.articulos[0]?.autor.nombre) · @(data.articulos[1]?.coautor?.nombre)</p>
<p>Índice: @valores[0] · [@(valores[9])] · [@(data.vacia?.[0])]</p>
<p>Mapa: @(data.stock["l"]) · [@(data.stock["xl"])]</p>
@* Plantilla sin etiqueta, con huecos de texto y de número. Sin diagnóstico. *@
<p>Plantilla: @(`id ${id} de ${nombre}`)</p>
@* `.length` de una lista y de un texto. Sin diagnóstico. *@
<p>Longitud: @(valores.length) · @(texto.length)</p>

<h2>Colecciones: el recetario</h2>
@* Cada necesidad, escrita con `filter`, `map`, `reduce`, `toSorted` y `.length`. Sin diagnóstico. *@
<ul>
  <li>Contar todos: @(data.tareas.length)</li>
  <li>Contar los que cumplen algo: @(data.tareas.filter(x => x.prioridad === 1).length)</li>
  <li>¿Hay alguno? @(data.tareas.filter(x => x.prioridad === 1).length > 0)</li>
  <li>¿Lo cumplen todos? @(data.tareas.filter(x => !x.hecha).length === 0)</li>
  <li>¿Está este valor? @(data.etiquetas.filter(e => e === "urgente").length > 0)</li>
  <li>El primero que cumple algo: @(data.tareas.filter(x => x.id === id % 5)[0]?.titulo)</li>
  <li>Los tres primeros:
    @foreach (const tarea of data.tareas.filter((x, i) => i < 3)) key (tarea.id) {
      <i>@tarea.titulo</i>
    }
  </li>
  <li>Filtrar lo que se pinta:
    @foreach (const tarea of data.tareas.filter(x => !x.hecha)) key (tarea.id) {
      <i>@tarea.titulo</i>
    }
  </li>
  <li>Sacar un campo:
    @foreach (const titulo of data.tareas.map(x => x.titulo)) key (titulo) {
      <i>@titulo</i>
    }
  </li>
  <li>Calcular por elemento:
    @foreach (const importe of data.lineas.map(l => l.precio * l.cantidad)) key (importe) {
      <i>@importe</i>
    }
  </li>
  <li>Suma: @(data.lineas.reduce((s, l) => s + l.precio * l.cantidad, 0))</li>
  <li>Máximo: @(data.notas.reduce((m, n) => n > m ? n : m, 0))</li>
  <li>Mínimo: @(data.notas.reduce((m, n) => n < m ? n : m, 10))</li>
  <li>Media: @(data.notas.length > 0 ? data.notas.reduce((s, n) => s + n, 0) / data.notas.length : 0)</li>
  <li>Unir texto: @(data.autores.reduce((s, a, i) => i === 0 ? a.nombre : `${s}, ${a.nombre}`, ""))</li>
  <li>Ordenar por número:
    @foreach (const tarea of data.tareas.toSorted((a, b) => a.prioridad - b.prioridad)) key (tarea.id) {
      <i>@tarea.titulo</i>
    }
  </li>
  <li>Ordenar por número, al revés:
    @foreach (const l of data.lineas.toSorted((a, b) => b.precio - a.precio)) key (l.nombre) {
      <i>@l.nombre</i>
    }
  </li>
  <li>Ordenar por fecha:
    @foreach (const tarea of data.tareas.toSorted((a, b) => a.creada < b.creada ? -1 : a.creada > b.creada ? 1 : 0)) key (tarea.id) {
      <i>@tarea.titulo</i>
    }
  </li>
  <li>Ordenar por texto:
    @foreach (const tarea of data.tareas.toSorted((a, b) => a.titulo < b.titulo ? -1 : a.titulo > b.titulo ? 1 : 0)) key (tarea.id) {
      <i>@tarea.titulo</i>
    }
  </li>
  <li>Encadenar: @(data.lineas.filter(l => !l.pagada).map(l => l.precio * l.cantidad).reduce((s, x) => s + x, 0))</li>
  <li>Directamente en la vista: <span>@(data.tareas.filter(x => x.hecha).length) de @(data.tareas.length)</span></li>
  <li>Caracteres que quedan: @(140 - texto.length)</li>
</ul>

<h2>Las tareas, en el cliente</h2>
@* Una lista que el usuario cambia: `signal`, `computed`, `@empty`, `now()` y manejadores. Sin diagnóstico. *@
<vista-tareas .inicial=@data.tareas></vista-tareas>

<h2>Desestructuración y resto</h2>
@* En la cabecera de `@foreach`: anidado, con renombre y con defecto, que también vale con `null`. Sin diagnóstico. *@
<ul>
  @foreach (const { titulo, autor: { nombre: quien }, destacado = false } of data.articulos) key (titulo) {
    <li>@titulo, de @quien @(destacado ? "(destacado)" : "")</li>
  }
</ul>
@* `...resto` se lee por campo, se esparce sobre un componente y se desestructura otra vez. Sin diagnóstico. *@
@{ const { variante, ...tarjeta } = data.tarjeta; }
<p>Variante: @variante · título del resto: @tarjeta.title</p>
<app-card ...tarjeta></app-card>
@{ const { href, ...soloTitulo } = tarjeta; }
<p>Otra vez: @soloTitulo.title en @href</p>
@* El resto de un objeto, esparcido sobre un nativo. Sin diagnóstico. *@
@{ const { etiqueta, ...campo } = data.campo; }
<label>@etiqueta <input ...campo></label>

<h2>Spread de atributos</h2>
@* Dos spreads y un atributo explícito: los del spread salen ordenados por nombre en el sitio del primero, y `title` es del último que lo tiene. Sin diagnóstico. *@
<a ...data.enlace ...data.extra class="boton">Leer</a>

<h2>Control</h2>
@* `@if`, `else if` y `else` con condiciones booleanas. Sin diagnóstico. *@
@if (id > 100) {
  <p>grande</p>
} else if (id > 10) {
  <p>mediano</p>
} else {
  <p>pequeño</p>
}
@* `@switch` sobre una unión de literales y sobre un número; cada `case` es un literal. Sin diagnóstico. *@
@switch (data.tono) {
  case "info": <p>información</p>
  case "aviso": <p>aviso</p>
  case "error": <p>error</p>
}
@switch (id % 3) {
  case 0: <p>múltiplo de 3</p>
  case 1: <p>resto 1</p>
  default: <p>resto 2</p>
}
@* `@foreach` con `@empty`: con cero vueltas se pinta el bloque, y solo él. Sin diagnóstico. *@
<ul>
  @foreach (const e of data.vacia) key (e) {
    <li>@e</li>
  } @empty {
    <li>No hay ninguna.</li>
  }
</ul>
@* `@for` escribe la variable que declara su cabecera; también lleva `@empty`. Sin diagnóstico. *@
<p>
  @for (let i = 0; i < 3; i++) key (i) {
    <span>[@i]</span>
  }
  @for (let i = 0; i < 0; i++) key (i) {
    <span>[@i]</span>
  } @empty {
    <span>ninguna vuelta</span>
  }
</p>
@* El `@while` canónico: el cursor vive en el `@code` y el template lo resiembra. Sin diagnóstico. *@
@{ cur = raiz; }
<ul>
  @while (cur !== undefined) key (cur.id) {
    <li>nodo @cur.n</li>
    @{ cur = cur.next; }
  } @empty {
    <li>lista vacía</li>
  }
</ul>
@* `@{ }` declara con `const` y `let` y reasigna variables, también un `let` del `@code`. Sin diagnóstico. *@
@{ let suma = 0; suma += prop1; suma = suma * prop2; suma++; total = prop1 + prop2; }
<p>Suma: @suma · total reasignado: @total</p>
@* Un nombre declarado en un `@{ }` se ve DESPUÉS, también dentro de un elemento. Sin diagnóstico. *@
<div>
  @{ const dentro = "visible"; }
  <p>Dentro del div: @dentro</p>
</div>
<p>Fuera del div, mismo bloque: @dentro</p>

<h2>Lo que el servidor evalúa del <code>@@code</code></h2>
@* Un literal de datos con tipo del contrato y un módulo de datos. Sin diagnóstico. *@
<p>Literal: @raiz.n → @(raiz.next?.n)</p>
<ol>
  @foreach (const p of pasos) key (p.n) {
    <li>@p.texto</li>
  }
</ol>

<h2 id="urls">URLs que el prefijo fija: sin guardia</h2>
<p>
  El texto literal del principio fija el origen, así que el compilador escribe el valor
  tal cual. Aunque el valor sea <code>@malicioso</code>, queda dentro de una ruta y no hay
  nada que ejecutar. Pasa el ratón por encima para ver el destino.
</p>
<ul>
  @* `/` seguido de algo que no es `/` ni `\`. Sin diagnóstico. *@
  <li><a href="/posts/@malicioso">href="/posts/@@malicioso"</a></li>
  @* El primer tramo de una plantilla cuenta igual que el texto literal. Sin diagnóstico. *@
  <li><a href=@(`/p/${malicioso}`)>href=@@(`/p/${malicioso}`)</a></li>
  @* `#`, `?` y `./` también fijan. Sin diagnóstico. *@
  <li><a href="#@malicioso">href="#@@malicioso"</a></li>
  <li><a href="?q=@malicioso">href="?q=@@malicioso"</a></li>
  <li><a href="./@malicioso">href="./@@malicioso"</a></li>
  @* Un esquema literal de la lista. Sin diagnóstico. *@
  <li><a href="https://example.com/@malicioso">href="https://example.com/@@malicioso"</a></li>
  @* `data:image/` literal en `<img src>`. Sin diagnóstico. *@
  <li><img class="punto" src="data:image/png;base64,@("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg==")" alt="punto"> src="data:image/png;base64,@@(…)"</li>
</ul>

<h2>URLs que el prefijo no fija: con guardia</h2>
<p>
  Cada fila enseña lo que escribe el autor. El guardia es automático, el mismo en el servidor
  y en el navegador: pasa el ratón por encima de cada enlace para ver lo que llegó al atributo.
</p>
<h3>Peligrosas: quedan en <code>about:blank</code></h3>
@* `href=@c.url`: un valor sin prefijo, así que va por el guardia. Sin diagnóstico. *@
@foreach (const c of data.peligrosas) key (c.clave) {
  <div class="caso">
    <a href=@c.url>@c.clave</a>
    <code>@c.url</code>
  </div>
}
<h3>Seguras: llegan intactas</h3>
@foreach (const c of data.seguras) key (c.clave) {
  <div class="caso">
    <a href=@c.url>@c.clave</a>
    <code>@c.url</code>
  </div>
}

<h3>Con guardia aunque el valor sea bueno</h3>
<ul>
  @* `/${x}`: la barra sola no fija nada; con `x = "/evil.example"` sale `//evil.example`, que es
     otro host. El guardia lo deja pasar porque no es un esquema peligroso. Sin diagnóstico. *@
  <li><a href=@(`/${otroHost}`)>href=@@(`/${otroHost}`)</a></li>
  @* Concatenación: no es una plantilla, así que no hay prefijo. Sin diagnóstico. *@
  <li><img class="punto" src=@(base + "/a.png") alt="cdn"> src=@@(base + "/a.png")</li>
  @* La misma imagen `data:` pasa en `<img src>`… Sin diagnóstico. *@
  <li><img class="punto" src=@png alt="punto rojo"> src=@@png en &lt;img&gt; → pasa</li>
  @* …y no en `<a href>`, ni en `srcset`. Sin diagnóstico. *@
  <li><a href=@png>href=@@png</a> → about:blank</li>
  @* `srcset`, candidato a candidato. Sin diagnóstico. *@
  <li><img class="punto" srcset=@srcsetBueno alt="srcset"> srcset bueno → pasa</li>
  <li><img class="punto" srcset=@srcsetMalo alt="srcset"> srcset malo → about:blank</li>
  @* El resto de atributos URL: `action`, `formaction`, `poster`, `cite`, `data` de `<object>`. Sin diagnóstico. *@
  <li>
    <form action=@malicioso method="get">
      <button formaction=@malicioso>action y formaction</button>
    </form>
  </li>
  <li><video class="punto" poster=@malicioso></video> poster</li>
  <li><blockquote cite=@malicioso>cite</blockquote></li>
  <li><object data=@malicioso></object> data de &lt;object&gt;</li>
  @* SVG: `href`. Sin diagnóstico. *@
  <li>
    <svg width="120" height="20">
      <a href=@malicioso><text x="0" y="15">svg href</text></a>
    </svg>
  </li>
</ul>

<h3><code>trustedUrl</code>: la excepción, marcada en el valor</h3>
<ul>
  @* Marcada en `@code`: el guardia la escribe tal cual. La misma cadena sin marcar está arriba, en las peligrosas. Sin diagnóstico. *@
  <li><a href=@abrir>href=@@abrir</a> → miapp:abrir</li>
</ul>

<h2>En el cliente</h2>
<p>
  El mismo guardia en el navegador: el componente cambia la URL con una signal y el
  atributo se reescribe. En desarrollo, cada sustitución avisa por la consola.
</p>
<vista-url></vista-url>
