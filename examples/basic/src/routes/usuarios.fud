<link rel="layout" href="../layouts/_layout.fud">
<link rel="component" href="../components/site-nav.fud">
<link rel="component" href="../components/user-form.fud">
<link rel="server" href="./usuarios.fudapi">

@code {
  import { effect, signal, task } from "@fudic/core";
  import { TOKEN_KEY } from "../browser/auth";

  const texto = signal("");
  // Vacío en los dos lados, para que el navegador parta de lo que pintó el servidor. El token
  // vive en este navegador, no en el servidor: se lee al cargar la página.
  const token = signal("");
  effect(() => {
    token.set(localStorage.getItem(TOKEN_KEY) ?? "");
  });

  // Cada cambio del texto lanza una búsqueda y cancela la anterior: gana la última.
  const found = task(search, () => ({ q: texto() }), { initial: [] });
  // La lenta solo sale con su botón, y tiene su propio «Cancelar».
  const lenta = task(slowSearch, undefined, { initial: [] });
  // Un PUT y un DELETE: van en fila, en el orden en que se pulsaron, y al acabar la tabla se
  // repinta con el `data` nuevo de `load`, sin recargar la página.
  const guardar = task(save);
  const quitar = task(remove);

  // La tabla pinta esta señal, que arranca con lo que trajo `load` y vuelve a sembrarse cada
  // vez que la página pide su `data` otra vez. Las altas de `user-form` llegan por el bus con
  // la persona que devolvió el servidor: se suman a la señal y la tabla se repinta, sin
  // recargar. Si el `data` nuevo ya la trajo —el `save` del formulario también lo pide—, no se
  // suma dos veces.
  const personas = signal(data.users);

  function alta(e: CustomEvent) {
    if (personas().some((p) => p.id === e.detail.id)) return;
    personas.set([...personas(), e.detail]);
  }

  function buscar(e: Event) {
    texto.set((e.target as HTMLInputElement).value);
  }

  function buscarLento() {
    void lenta.run({ q: texto() });
  }

  function cancelarLento() {
    lenta.cancel();
  }

  function activar(id: number, e: Event) {
    void guardar.run({ id, active: (e.target as HTMLInputElement).checked });
  }

  function borrar(id: number) {
    void quitar.run({ id });
  }

  function entrar(nombre: string) {
    localStorage.setItem(TOKEN_KEY, nombre);
    token.set(nombre);
  }

  function salir() {
    localStorage.removeItem(TOKEN_KEY);
    token.set("");
  }

  async function romper() {
    await crash();
  }

  async function borrarNadie() {
    await remove({ id: 999 });
  }
}

<head>
  <title>Usuarios — fudic</title>
  <style>
    .panel {
      display: grid;
      gap: 0.9rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-box);
      padding: var(--pad-box);
      background: var(--surface);
      margin-bottom: 1rem;
    }
    .row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      align-items: center;
    }
    .panel button {
      font: inherit;
      padding: 0.35rem 0.8rem;
      border: 1px solid var(--brand);
      border-radius: var(--radius);
      background: var(--brand);
      color: white;
      cursor: pointer;
    }
    .panel input[type="search"] {
      font: inherit;
      padding: var(--pad-field);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }
    table {
      border-collapse: collapse;
      width: 100%;
    }
    th, td {
      text-align: left;
      padding: 0.35rem 0.5rem;
      border-bottom: 1px solid var(--line);
    }
  </style>
</head>

@section nav {
  <site-nav .current="usuarios"></site-nav>
}

<h1>Funciones de servidor</h1>
<p class="lede">
  Cada botón de esta página llama a una función declarada en el <code>.fudapi</code> de la ruta
  o del componente. El cliente no construye URLs, ni cabeceras, ni <code>fetch</code>: llama a
  <code>search</code>, <code>save</code> o <code>remove</code> por su nombre, con sus tipos.
</p>

<h2>Sesión</h2>
<div class="panel">
  <div class="row">
    <span>Token: <strong>@(token() === "" ? "ninguno" : token())</strong></span>
    <button @click=@entrar("ana")>Entrar como Ana</button>
    <button @click=@entrar("pepe")>Entrar con un token falso</button>
    <button @click=@salir>Salir</button>
  </div>
  <p>
    Estos botones no llaman al servidor: solo guardan el token en el navegador. Viaja después,
    en la cabecera <code>authorization</code> de <em>Borrar</em> y de <em>Activo</em>, que
    llevan <code>auth</code>: míralo en Network, en las cabeceras de esa petición. Sin token
    responden 401 y <code>errorPages</code> lleva a la página de error, que dice «sin token».
    Con uno que el servidor no conoce responden 403, y <code>errorPages({ 403: "/entrar" })</code>
    lleva a <a href="/entrar">/entrar</a>.
  </p>
</div>

<h2>Personas</h2>
<div class="panel" bus:alta=@alta($event)>
  <table>
    <thead>
      <tr><th>Nombre</th><th>Email</th><th>Edad</th><th>Activo</th><th></th></tr>
    </thead>
    <tbody>
      @foreach (const p of personas()) key (p.id) {
        <tr>
          <td>@p.name</td>
          <td>@p.email</td>
          <td>@p.age</td>
          <td><input type="checkbox" checked=@p.active @change=@activar(p.id, $event) aria-label="Activo"></td>
          <td><button @click=@borrar(p.id)>Borrar</button></td>
        </tr>
      }
    </tbody>
  </table>
  <p>
    Marcar o desmarcar <em>Activo</em> y <em>Borrar</em> no recargan la página. En Network sale
    el <code>save</code> o el <code>remove</code> y, justo después, una sola petición a
    <code>/_fudic/data/usuarios</code>: la página pide su <code>data</code> nuevo y la tabla se
    repinta sin perder el scroll ni el foco. Si marcas deprisa varias veces, los
    <code>save</code> salen en fila, uno detrás de otro, en el orden en que pulsaste.
  </p>
</div>

<h2>Buscar</h2>
<div class="panel">
  <div class="row">
    <input type="search" placeholder="Nombre…" aria-label="Buscar por nombre" @input=@buscar>
    <span role="status">@(found.pending() ? "Buscando…" : "")</span>
  </div>
  <p>
    Cada tecla lanza una búsqueda y cancela la anterior: en Network la vieja sale como
    <em>canceled</em>, y lo que se pinta es siempre la respuesta de la última.
  </p>
  <ul>
    @foreach (const p of found.value()) key (p.id) {
      <li>@p.name — @p.email</li>
    }
  </ul>
</div>

<h2>Búsqueda lenta</h2>
<div class="panel">
  <div class="row">
    <button @click=@buscarLento>Búsqueda lenta (3 s)</button>
    <button @click=@cancelarLento>Cancelar</button>
    <span role="status">@(lenta.pending() ? "Buscando…" : lenta.state() === "cancelled" ? "Búsqueda cancelada." : "")</span>
  </div>
  <p>
    Busca el texto de arriba y tarda tres segundos a propósito: pulsa <em>Cancelar</em> antes y
    en Network sale como <em>canceled</em>.
  </p>
  <ul>
    @foreach (const p of lenta.value()) key (p.id) {
      <li>@p.name — @p.email</li>
    }
  </ul>
</div>

<h2>Alta</h2>
<p>
  El formulario es <code>user-form</code>, un componente con su propia función
  <code>save</code>. Sus controles son todos tipados, así que sube en binario; con unas notas
  largas, además comprimido. Prueba un email que ya existe: el error lo pone el servidor. Al
  guardar, el componente emite la persona por el bus y la tabla de arriba la recoge, sin
  recargar la página.
</p>
<user-form></user-form>

<h2>Errores</h2>
<div class="panel">
  <div class="row">
    <button @click=@romper>Un 500</button>
    <button @click=@borrarNadie>Borrar a alguien que no existe</button>
  </div>
</div>
