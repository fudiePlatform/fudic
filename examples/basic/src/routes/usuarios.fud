<link rel="layout" href="../layouts/_layout.fud">
<link rel="component" href="../components/site-nav.fud">
<link rel="component" href="../components/user-form.fud">
<link rel="server" href="./usuarios.fudapi">

@code {
  import { signal, task } from "@fudic/core";
  import type { Person } from "fudic:routes/usuarios";

  const texto = signal("");

  // Cada cambio del texto lanza una búsqueda y cancela la anterior: gana la última.
  const found = task(search, () => ({ q: texto() }), { initial: [] });
  // La lenta solo sale con su botón, y tiene su propio «Cancelar».
  const lenta = task(slowSearch, undefined, { initial: [] });
  // Un PUT y un DELETE: van en fila, en el orden en que se pulsaron. Ninguno hace que la página
  // pida su `data` otra vez: la tabla ya sabe qué cambió y se pone al día ella sola.
  const guardar = task(save);
  const quitar = task(remove);

  // La tabla pinta esta señal, que arranca con lo que trajo `load`. Activar y borrar la ponen
  // al día cuando el servidor dice que sí; las altas de `user-form` llegan en su `@fudic:result`
  // con la persona que devolvió el servidor y se suman a ella. Nada recarga y nada pide la lista otra
  // vez.
  const personas = signal(data.users);

  function alta(persona: Person) {
    personas.set([...personas(), persona]);
  }

  // `$value` es el valor del buscador, ya como `string`: sin `e.target` ni cast.
  function buscar(q: string) {
    texto.set(q);
  }

  function buscarLento() {
    void lenta.run({ q: texto() });
  }

  function cancelarLento() {
    lenta.cancel();
  }

  function marcar(id: number, active: boolean) {
    personas.set(personas().map((x) => (x.id === id ? { ...x, active } : x)));
  }

  // En optimista: primero la señal, luego el servidor, y si no sale bien se deshace. La casilla
  // sigue a la señal en cada repintado, así que no hay que tocarla a mano; el motivo de un error
  // que se queda en la página (`catches 409`) lo pinta la vista con `guardar.message()`.
  // Las tres reciben la persona de la fila pulsada: la tabla tiene un listener por handler en el
  // `<tbody>`, no uno por fila, y cada fila se marca con `delegate:p` para el evento que sirve.
  // `activar` recibe además `$value`, el `checked` de la casilla de esa fila, ya como `boolean`.
  async function activar(p: Person, active: boolean) {
    marcar(p.id, active);
    const guardado = await guardar.run({ id: p.id, active });
    if (!guardado.ok) {
      marcar(p.id, !active);
    }
  }

  async function borrar(p: Person) {
    const borrado = await quitar.run({ id: p.id });
    if (borrado.ok) {
      personas.set(personas().filter((x) => x.id !== p.id));
      vista.set(vista().filter((x) => x.id !== p.id));
    }
  }

  // La ficha de la persona pulsada. *Borrar* y *Ver* son dos `click` en la misma fila: cada botón
  // pide el suyo por nombre (`delegate:p="click.ver"`) y el `<tbody>` los separa
  // (`@click.ver`, `@click.borrar`). Una lista de cero o una persona, para pintarla con su tipo.
  const vista = signal<Person[]>([]);

  function ver(p: Person) {
    vista.set([p]);
  }

  // Entrar y salir son dos funciones del servidor: ponen y quitan la cookie. Las dos nombran
  // esta página en su `invalidates`, así que la página pide su `data` nuevo, que dice quién hay
  // dentro, y se repinta.
  async function entrar(nombre: string) {
    await login({ user: nombre });
  }

  async function salir() {
    await logout();
  }

  async function romper() {
    await crash();
  }

  async function borrarNadie() {
    await remove({ id: 999 });
  }
}

<head>
  <title>Usuarios — fudic</title>
  <style>
    .panel {
      display: grid;
      gap: 0.9rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-box);
      padding: var(--pad-box);
      background: var(--surface);
      margin-bottom: 1rem;
    }
    .row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      align-items: center;
    }
    .panel button {
      font: inherit;
      padding: 0.35rem 0.8rem;
      border: 1px solid var(--brand);
      border-radius: var(--radius);
      background: var(--brand);
      color: white;
      cursor: pointer;
    }
    .panel input[type="search"] {
      font: inherit;
      padding: var(--pad-field);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }
    /* La cookie lleva el nombre tal cual, «ana»: se pinta «Ana». */
    .quien {
      text-transform: capitalize;
    }
    table {
      border-collapse: collapse;
      width: 100%;
    }
    .ficha {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.2rem 0.8rem;
      margin: 0;
    }
    .ficha dd {
      margin: 0;
    }
    th, td {
      text-align: left;
      padding: 0.35rem 0.5rem;
      border-bottom: 1px solid var(--line);
    }
  </style>
</head>

@section nav {
  <site-nav .current="usuarios"></site-nav>
}

<h1>Funciones de servidor</h1>
<p class="lede">
  Cada botón de esta página llama a una función declarada en el <code>.fudapi</code> de la ruta
  o del componente. El cliente no construye URLs, ni cabeceras, ni <code>fetch</code>: llama a
  <code>search</code>, <code>save</code> o <code>remove</code> por su nombre, con sus tipos.
</p>

<h2>Sesión</h2>
<div class="panel">
  <div class="row">
    <span>Sesión: <strong class="quien">@(data.session === undefined ? "ninguna" : data.session)</strong></span>
    <button @click=@entrar("ana")>Entrar como Ana</button>
    <button @click=@entrar("luis")>Entrar como Luis</button>
    <button @click=@entrar("pepe")>Entrar con una sesión falsa</button>
    <button @click=@salir>Salir</button>
  </div>
  <p>
    Entrar y salir llaman a <code>login</code> y <code>logout</code>, dos funciones del
    servidor que ponen y quitan la cookie <code>fudic-session</code>. Es <code>HttpOnly</code>:
    ningún script de la página la lee, así que no sale en <code>document.cookie</code>; se ve
    en DevTools, en <em>Application → Cookies</em>. El navegador la manda solo en cada
    petición: la de <em>Borrar</em> y la de <em>Activo</em>, que llevan <code>auth</code>, la
    llevan en <code>cookie</code>, y ninguna lleva un token puesto a mano. Sin
    sesión responden 401 y <code>error-pages</code> lleva a la página de error, que dice «sin
    sesión». Con una que el servidor no conoce responden 403, y <code>error-pages</code> lleva a
    <a href="/entrar">/entrar</a>.
  </p>
</div>

<h2>Personas</h2>
<div class="panel">
  <table>
    <thead>
      <tr><th>Nombre</th><th>Email</th><th>Edad</th><th>Activo</th><th></th><th></th></tr>
    </thead>
    <tbody @change=@activar(p, $value) @click.borrar=@borrar(p) @click.ver=@ver(p)>
      @foreach (const p of personas()) key (p.id) {
        <tr>
          <td>@p.name</td>
          <td>@p.email</td>
          <td>@p.age</td>
          <td><input type="checkbox" checked=@p.active delegate:p="change" aria-label="Activo"></td>
          <td><button delegate:p="click.ver">Ver</button></td>
          <td><button delegate:p="click.borrar">Borrar</button></td>
        </tr>
      }
    </tbody>
  </table>
  @foreach (const v of vista()) key (v.id) {
    <dl class="ficha" aria-label="Ficha">
      <dt>Nombre</dt><dd>@v.name</dd>
      <dt>Email</dt><dd>@v.email</dd>
      <dt>Edad</dt><dd>@v.age</dd>
      <dt>Notas</dt><dd>@(v.notes === "" ? "—" : v.notes)</dd>
    </dl>
  }
  @if (guardar.message() !== "") {
    <p role="alert">@guardar.message()</p>
  }
  <p>
    La tabla usa un listener por handler en el <code>&lt;tbody&gt;</code>, tenga las filas que
    tenga: <code>change</code> para la casilla y dos <code>click</code>, uno con nombre para cada
    botón (<code>@@click.ver</code> y <code>@@click.borrar</code>), así que <em>Ver</em> nunca llega a
    <em>Borrar</em>. La casilla pasa <code>$value</code>, su <code>checked</code>, ya como
    <code>boolean</code>. <em>Ver</em> pinta la ficha de la persona debajo de la tabla. Marcar o
    desmarcar <em>Activo</em> y <em>Borrar</em> no recargan la página. En Network sale
    el <code>save</code> o el <code>remove</code> y nada más: la tabla ya sabe qué cambió y se
    repinta sola, sin perder el scroll ni el foco. Si el servidor dice que no, la casilla vuelve
    a como estaba. Si marcas deprisa varias veces, los <code>save</code> salen en fila, uno
    detrás de otro, en el orden en que pulsaste.
  </p>
  <p>
    Desmarca a Ana: el servidor responde 409 y la página se queda, con el motivo debajo de la
    tabla. Lo que una función pone en su <code>catches</code> se queda en la página; lo demás va a
    <code>error-pages</code>, como el 404 de <em>Borrar a alguien que no existe</em>.
  </p>
</div>

<h2>Buscar</h2>
<div class="panel">
  <div class="row">
    <input type="search" placeholder="Nombre…" aria-label="Buscar por nombre" @input=@buscar($value)>
    <span role="status">@(found.pending() ? "Buscando…" : "")</span>
  </div>
  <p>
    Cada tecla lanza una búsqueda y cancela la anterior: en Network la vieja sale como
    <em>canceled</em>, y lo que se pinta es siempre la respuesta de la última. El servidor del
    ejemplo tarda 400 ms a propósito, lo que tardaría una red real: en local contestaría en un
    par de milisegundos y «Buscando…» solo parpadearía.
  </p>
  <ul>
    @foreach (const p of found.value()) key (p.id) {
      <li>@p.name — @p.email</li>
    }
  </ul>
</div>

<h2>Búsqueda lenta</h2>
<div class="panel">
  <div class="row">
    <button @click=@buscarLento>Búsqueda lenta (3 s)</button>
    <button @click=@cancelarLento>Cancelar</button>
    <span role="status">@(lenta.pending() ? "Buscando…" : lenta.state() === "cancelled" ? "Búsqueda cancelada." : "")</span>
  </div>
  <p>
    Busca el texto de arriba y tarda tres segundos a propósito: pulsa <em>Cancelar</em> antes y
    en Network sale como <em>canceled</em>.
  </p>
  <ul>
    @foreach (const p of lenta.value()) key (p.id) {
      <li>@p.name — @p.email</li>
    }
  </ul>
</div>

<h2>Alta</h2>
<p>
  El formulario es <code>user-form</code>, un componente con su propia función
  <code>save</code>. Sus controles son todos tipados, así que sube en binario; con unas notas
  largas, además comprimido. Prueba un email que ya existe: el error lo pone el servidor. Al
  guardar, el <code>fudic:result</code> de su formulario sale del componente y esta página lo
  escucha en el tag, <code>&lt;user-form @@fudic:result=@@alta&gt;</code>, con la persona ya
  tipada: la tabla de arriba la recoge sin recargar la página.
</p>
<user-form @fudic:result=@alta></user-form>

<h2>Errores</h2>
<div class="panel">
  <div class="row">
    <button @click=@romper>Un 500</button>
    <button @click=@borrarNadie>Borrar a alguien que no existe</button>
  </div>
</div>
