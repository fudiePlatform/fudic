# The email belongs to somebody else already. Only on the server, on submit: it reads the people
# table, which never reaches the browser.
rule email-taken
  on field str
  runs server
  async
  fails email-taken

# The alias is taken. The alias table stays on the server too, but this one is remote: the
# browser asks it while the user types, 300 ms after the last key, and the server runs it again
# on submit.
# `email-taken` stays `server`, so both can be seen side by side.
rule alias-taken
  on field str
  runs remote
  fails alias-taken

# Something, an at sign, something, a dot and something.
pattern email-loose  [^@\s]+@[^@\s]+\.[^@\s]+

pattern web-url      https?://.+
