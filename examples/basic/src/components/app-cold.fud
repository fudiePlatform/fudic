@code {
  // El caso frío. Vive dentro de un `<details>` cerrado, así que su instancia nunca entra
  // en el viewport y el warm no lo toca: al abrirlo y pulsar de inmediato, el `import()`
  // paga red dentro del gesto. Es la evidencia de que el warm es OPTIMIZACIÓN — esto
  // hidrata igual, solo que pagando.
  @client {
    import { signal } from "@fudic/core";

    const hits = signal(0);

    function hit() {
      hits.set(hits() + 1);
    }
  }
}

<head>
  <style>
    button {
      border-color: #d93025;
      color: #a50e0e;
    }
  </style>
</head>

<app-cold>
  <template shadowrootmode="open">
    <button class="hit" @click=@hit>Sin precachear: <span class="value">@hits()</span></button>
  </template>
</app-cold>
