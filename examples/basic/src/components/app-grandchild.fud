<link rel="component" href="./app-greatgrandchild.fud">

@code {
  // Profundidad 2. Mismo papel que el hijo: recibe el valor y lo baja.
  const { count = 0 } = props<{ count?: number }>();

  @client {
    import { signal } from '@fudic/core';

    const eco = signal(0);

    function ping() {
      eco.set(eco() + 1);
    }
  }
}

<head>
  <style>
    :host {
      display: block;
      padding-left: 0.9rem;
    }
    p {
      margin: 0 0 0.35rem;
      display: flex;
      gap: 0.5rem;
      align-items: baseline;
    }
    button {
      font: inherit;
      font-size: 0.8rem;
      padding: 0.1rem 0.5rem;
      border: 1px solid #dcdcdc;
      border-radius: 999px;
      background: white;
      cursor: pointer;
    }
  </style>
</head>

<app-grandchild>
  <template shadowrootmode="open">
    <p>nieto (prof 2): <strong class="value">@count</strong>
      <button class="eco" @click="@ping">eco @(eco())</button></p>
    <app-greatgrandchild .count="@count"></app-greatgrandchild>
  </template>
</app-grandchild>
