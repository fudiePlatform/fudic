@code {
  // Una prop de FUNCIÓN. No hay valor que serializar, así que su celda nace vacía — y esa
  // ausencia es la instrucción: el runtime levanta primero al dueño y solo después le
  // entrega su tramo a este hijo. Por eso el callback corre en el primer clic, no en el
  // segundo.
  const { onSave } = props<{ onSave: (n: number) => void }>();
}

<head>
  <style>
    :host {
      display: block;
      margin-top: 0.75rem;
    }
    .form {
      display: flex;
      gap: 0.6rem;
      align-items: center;
      padding: 0.7rem 0.9rem;
      border: 1px solid #e0a800;
      border-radius: 8px;
      background: #fffaf0;
    }
    .save {
      font: inherit;
      padding: 0.35rem 0.8rem;
      border: 1px solid #e0a800;
      border-radius: 6px;
      background: #ffc107;
      cursor: pointer;
    }
    .hint {
      margin: 0;
      font-size: 0.78rem;
      color: #8a6d00;
    }
  </style>
</head>

<signal-form>
  <template shadowrootmode="open">
    <div class="form">
      <button class="save" @click=@onSave(5)>Sumar 5 desde el hijo</button>
      <p class="hint">El hijo llama a una función del padre, sin bus y sin evento.</p>
    </div>
  </template>
</signal-form>
