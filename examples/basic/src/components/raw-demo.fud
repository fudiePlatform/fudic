@code {
  import { trustedHtml, type TrustedHTML } from "@fudic/dom";

  // HTML que llega del servidor (`html` en el `.fudapi` de la ruta): viaja como texto, sin la
  // marca, así que `@raw` lo escribe como texto escapado.
  const { falsa } = props<{ falsa?: TrustedHTML }>();

  // HTML que el autor avala: la marca va en el VALOR, igual que `trustedUrl`.
  const uno = trustedHtml('<h3>Primer post</h3><p>Con <em>énfasis</em> y un <a href="/">enlace</a>.</p>');
  const dos = trustedHtml("<h3>Segundo post</h3><ul><li>uno</li><li>dos</li></ul>");


  import { signal } from "@fudic/core";

  const post = signal(uno);
  const clics = signal(0);

  function cambiar() {
    post.set(post() === uno ? dos : uno);
  }

  function sumar() {
    clics.set(clics() + 1);
  }
}

<head>
  <style>
    .panel {
      display: grid;
      gap: var(--gap);
      max-width: 36rem;
    }
    .post,
    .crudo {
      padding: 0.6rem 0.9rem;
      border: 1px solid var(--brand);
      border-radius: 8px;
    }
    .crudo {
      border-style: dashed;
    }
  </style>
</head>

<raw-demo>
  <template shadowrootmode="open">
    <div class="panel">
      <button class="cambiar" @click="@cambiar">Cambiar post</button>
      <article class="post">@raw(post())</article>
      <div class="crudo">@raw(falsa)</div>
      <p class="despues">
        Lo de después sigue vivo: <button class="sumar" @click="@sumar">+1</button>
        <span class="clics">@clics()</span>
      </p>
    </div>
  </template>
</raw-demo>
