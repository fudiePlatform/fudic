@code {
  // El suscriptor. Escucha en `document`, que es el ancestro común de la página: un
  // `@carrito` de host no recibiría nada. Tiene que estar VIVO antes de que el handler del
  // emisor corra, y eso es exactamente lo que la pre-hidratación de bus garantiza.
  @client {
    import { signal } from '@fudic/core';

    const items = signal(0);
    const total = signal(0);

    function onCarrito(ev) {
      items.set(items() + 1);
      total.set(total() + Number(ev.detail));
    }
  }
}

<head>
  <style>
    :host {
      display: block;
    }
    .cart {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      margin: 0;
      padding: 0.75rem 0.9rem;
      border: 1px dashed #34a853;
      border-radius: 8px;
      background: #f2f9f4;
    }
    .badge {
      display: inline-grid;
      place-items: center;
      min-width: 1.8rem;
      padding: 0.15rem 0.4rem;
      border-radius: 999px;
      background: #34a853;
      color: white;
      font-variant-numeric: tabular-nums;
    }
  </style>
</head>

<shopping-cart>
  <template shadowrootmode="open">
    <p class="cart" bus:carrito="@onCarrito($event)">
      <span class="badge">@(items())</span>
      <span class="total">@(total().toFixed(2)) €</span>
    </p>
  </template>
</shopping-cart>
