@code {
  // El contador de los caminos 1, 2 y 3. Su `start` viene del servidor, así que dos
  // instancias del mismo tag arrancan en números distintos: es la prueba de que cada una
  // lee SU tramo del payload y no el de la otra.
  const { start = 0 } = props<{ start?: number }>();

  @client {
    import { signal } from '@fudic/core';

    const n = signal(start);

    function inc() {
      n.set(n() + 1);
    }
  }
}

<head>
  <style>
    :host {
      display: block;
    }
    .panel {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      border: 1px solid #dcdcdc;
      border-radius: 10px;
      padding: 0.9rem 1.1rem;
      background: white;
    }
    button {
      font: inherit;
      padding: 0.4rem 0.9rem;
      border: 1px solid #1a73e8;
      border-radius: 6px;
      background: #1a73e8;
      color: white;
      cursor: pointer;
    }
    output {
      font-variant-numeric: tabular-nums;
      font-size: 1.35rem;
    }
  </style>
</head>

<app-counter>
  <template shadowrootmode="open">
    <div class="panel">
      <button class="inc" @click="@inc">+1</button>
      <output class="value">@(n())</output>
    </div>
  </template>
</app-counter>
