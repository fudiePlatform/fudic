@code {
  // El contador de los caminos 1, 2 y 3. Su `start` viene del servidor, así que dos
  // instancias del mismo tag arrancan en números distintos: es la prueba de que cada una
  // lee SU tramo del payload y no el de la otra.
  const { start = 0 } = props<{ start?: number }>();

  @client {
    import { signal } from "@fudic/core";

    const n = signal(start);

    function inc() {
      n.set(n() + 1);
    }
  }
}

<head>
  <style>
    .panel {
      display: flex;
      gap: var(--gap);
      align-items: center;
    }
    button {
      border-color: var(--brand);
      background: var(--brand);
      color: white;
    }
    output {
      font-variant-numeric: tabular-nums;
      font-size: 1.35rem;
    }
  </style>
</head>

<app-counter>
  <template shadowrootmode="open">
    <div class="panel">
      <button class="inc" @click=@inc>+1</button>
      <output class="value">@n()</output>
    </div>
  </template>
</app-counter>
