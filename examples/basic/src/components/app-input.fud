@code {
  import type { Control } from "@fudic/forms";

  // Un control-componente: recibe el NODO del formulario por la prop `ctrl` y lo enlaza a su
  // propio `<input>`. El marcador `formassociated` del template es lo que decide de qué clase
  // hereda lo que se emite, que su shadow root delegue el foco, y que su tag se defina al
  // cargar la página en vez de al primer gesto.
  //
  // `Control<unknown>` y `type` como PROP, y las dos cosas van juntas. Un `Control<T>` es
  // asignable a `Control<unknown>`, así que el cruce se sigue comprobando —tiene que ser un
  // control, no un grupo ni un formulario— sin atar el componente a un solo tipo de valor. Y
  // como el `type` no se conoce en compilación, el enlace lo elige `bindByType` al enlazar
  // (decisión 109): un `app-input` para cualquier forma de `<input>`, en vez de uno por forma.
  const { ctrl, type, id } = props<{ ctrl: Control<unknown>; type?: string; id?: string }>();
}

<head>
  <style>
    :host {
      display: block;
    }
    .field {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      border: 1px solid #dcdcdc;
      border-radius: 8px;
      padding: 0.4rem 0.6rem;
      background: white;
    }
    input {
      font: inherit;
      border: 0;
      outline: none;
      flex: 1;
    }
    [data-fud-err] {
      color: #b3261e;
      font-size: 0.85rem;
    }
    [data-fud-err]:empty {
      display: none;
    }
  </style>
</head>

<app-input>
  <template shadowrootmode="open" formassociated>
    <div class="field">
      <slot name="icon"></slot>
      <input id=@id type=@type control=@ctrl>
    </div>
  </template>
</app-input>
