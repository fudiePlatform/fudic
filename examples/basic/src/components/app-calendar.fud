@code {
  // La rejilla DELEGADA: un `@click` en el contenedor, y cada celda entrega su propia fila.
  // No hay `data-*`, no hay `closest()`, no hay `Number(...)` — el objeto llega entero.
  import { makeDays, type Day } from "../data/days.js";

  // La zona neutra corre en los DOS lados, así que estas siete filas las pinta el servidor y
  // el cliente las adopta. No es un `load()` porque no son un dato de la página: son el
  // banco de pruebas del componente.
  const seed = makeDays("a");

  @client {
    import { signal } from "@fudic/core";

    const rows = signal(seed);
    const last = signal("—");
    let extra = 0;

    // El handler recibe el OBJETO de la fila. Le suma una marca encima: si en el siguiente
    // clic el número ha subido, es que llegó el mismo objeto y no una copia.
    function pick(day: Day) {
      day.picks += 1;
      last.set(`día ${day.n} · pulsado ${day.picks} ${day.picks === 1 ? "vez" : "veces"}`);
    }

    function add() {
      extra += 1;
      const more = [];
      for (let i = 1; i <= 7; i++) {
        more.push({ id: `x${extra}-${i}`, n: 100 * extra + i, picks: 0 });
      }
      rows.set([...rows(), ...more]);
    }

    function drop() {
      rows.set(rows().slice(0, Math.max(0, rows().length - 7)));
    }

    function shuffle() {
      rows.set([...rows()].reverse());
    }
  }
}

<head>
  <style>
    :host {
      display: block;
    }
    .panel {
      border: 1px solid #dcdcdc;
      border-radius: 10px;
      padding: 0.9rem 1.1rem;
      background: white;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 4px;
      margin: 0.75rem 0;
    }
    .cell {
      display: grid;
      gap: 2px;
      justify-items: center;
      padding: 0.35rem 0.2rem;
      border: 1px solid #e6e6e6;
      border-radius: 6px;
      cursor: pointer;
      font-variant-numeric: tabular-nums;
    }
    .cell:hover {
      background: #f1f6ff;
      border-color: #1a73e8;
    }
    .cell button {
      font: inherit;
      font-size: 0.7rem;
      padding: 0 0.3rem;
      border: 1px solid #dcdcdc;
      border-radius: 4px;
      background: #fafafa;
      cursor: pointer;
    }
    .bar {
      display: flex;
      gap: 0.5rem;
      align-items: baseline;
      flex-wrap: wrap;
    }
    .bar button {
      font: inherit;
      padding: 0.35rem 0.8rem;
      border: 1px solid #1a73e8;
      border-radius: 6px;
      background: #1a73e8;
      color: white;
      cursor: pointer;
    }
    output {
      font-weight: 500;
    }
    .hueco {
      color: #999;
      padding: 0.35rem 0.2rem;
      text-align: center;
    }
  </style>
</head>

<app-calendar>
  <template shadowrootmode="open">
    <section class="panel">
      @* Un solo `@click`, en el contenedor. Las celdas no llevan listener: llevan marcador. *@
      <div class="grid" @click=@pick($day)>
        <div class="hueco">pad</div>
        @foreach (const day of rows()) key (day.id) {
          <div class="cell" delegate:day>
            <span>@day.n</span>
            <button delegate:day>✎</button>
          </div>
        }
      </div>

      <div class="bar">
        <button class="add" @click=@add>+7 filas</button>
        <button class="drop" @click=@drop>−7 filas</button>
        <button class="shuffle" @click=@shuffle>Invertir</button>
        <span>Último: <output class="last">@last()</output></span>
        <span>Filas: <output class="rows">@rows().length</output></span>
      </div>
    </section>
  </template>
</app-calendar>
