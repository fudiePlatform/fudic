@code {
  // Doce campos enlazados, y nada más. Lo que se mide aquí no es el formulario: es cuántos
  // listeners pide al hidratar. Con la delegación de SDD-37 son tres —uno por tipo de
  // evento en la raíz— y no treinta y seis.
  import { wideForm } from "../forms/wide.form.js";

  @client {
    function stop(e: Event) {
      e.preventDefault();
    }
  }
}

<head>
  <style>
    form {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-box);
      padding: 1.1rem;
      background: var(--surface);
    }
    label {
      display: grid;
      gap: 0.2rem;
      font-size: 0.85rem;
      font-weight: 500;
    }
    input {
      font: inherit;
      padding: 0.35rem 0.5rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      min-width: 0;
    }
    .error {
      color: #b3261e;
      font-size: 0.8rem;
      font-weight: 400;
    }
    .error:empty {
      display: none;
    }
    [aria-invalid="true"] {
      border-color: #b3261e;
    }
    button {
      grid-column: 1 / -1;
      justify-self: start;
      border-color: var(--brand);
      background: var(--brand);
      color: white;
    }
  </style>
</head>

<app-wide-form>
  <template shadowrootmode="open">
    <form control=@wideForm class="fudic" @submit=@stop>
      @* Solo los dos campos con reglas llevan marcador: los otros diez no tienen nada que decir. *@
      <label>1 (obligatorio) <input control=@wideForm.a1 type="text"><span class="error" error=@wideForm.a1></span></label>
      <label>2 (mín. 2) <input control=@wideForm.a2 type="text"><span class="error" error=@wideForm.a2></span></label>
      <label>3 <input control=@wideForm.a3 type="text"></label>
      <label>4 <input control=@wideForm.a4 type="text"></label>
      <label>5 <input control=@wideForm.a5 type="text"></label>
      <label>6 <input control=@wideForm.a6 type="text"></label>
      <label>7 <input control=@wideForm.a7 type="text"></label>
      <label>8 <input control=@wideForm.a8 type="text"></label>
      <label>9 <input control=@wideForm.a9 type="text"></label>
      <label>10 <input control=@wideForm.a10 type="text"></label>
      <label>11 <input control=@wideForm.a11 type="text"></label>
      <label>12 <input control=@wideForm.a12 type="text"></label>
      <button type="submit">Validar</button>
    </form>
  </template>
</app-wide-form>
