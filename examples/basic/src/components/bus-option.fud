@code {
  // The leaf of the map demo. It has props of its own — so its slice in `fud-state` is
  // not empty — and a signal, so it hydrates on its own account.
  const { label = "", picked = false } = props<{ label?: string; picked?: boolean }>();

  @client {
    import { signal } from "@fudic/core";

    const hot = signal(false);

    function enter() {
      hot.set(true);
    }
  }
}

<head>
  <style>
    button {
      width: 100%;
      text-align: left;
    }
    button[data-picked="true"] {
      border-color: var(--brand);
      color: var(--brand);
    }
  </style>
</head>

<bus-option>
  <template shadowrootmode="open">
    <button data-picked=@picked @mouseenter=@enter>@label</button>
  </template>
</bus-option>
