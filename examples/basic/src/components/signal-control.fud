@code {
  @client {
    import { signal, computed } from "@fudic/core";

    // Una sola signal mueve los cuatro constructos. Ninguno la recibe por prop: los cuatro
    // la LEEN en su cabecera, que es lo que esta página está aquí para comprobar.
    const count = signal(1);

    // El `@foreach` necesita una lista, y la lista se deriva del contador. Un `computed`
    // no se suscribe a nada: la hoja de debajo —`count`— es la que avisa.
    const filas = computed(() => Array.from({ length: count() }, (_, i) => ({ id: i })));

    function mas() {
      count.set(count() + 1);
    }

    function menos() {
      count.set(Math.max(0, count() - 1));
    }
  }
}

<head>
  <style>
    :host {
      display: block;
    }
    .panel {
      display: grid;
      gap: 0.9rem;
      border: 1px solid #dcdcdc;
      border-radius: 10px;
      padding: 1rem 1.15rem;
      background: white;
    }
    .row {
      display: flex;
      gap: 0.6rem;
      align-items: center;
    }
    button {
      font: inherit;
      padding: 0.35rem 0.8rem;
      border: 1px solid #1a73e8;
      border-radius: 6px;
      background: #1a73e8;
      color: white;
      cursor: pointer;
    }
    .valor {
      font-size: 1.4rem;
      font-variant-numeric: tabular-nums;
      min-width: 2ch;
      text-align: center;
    }
    .caso {
      display: grid;
      grid-template-columns: 6.5rem 1fr;
      gap: 0.75rem;
      align-items: start;
      padding: 0.55rem 0.7rem;
      border: 1px dashed #34a853;
      border-radius: 8px;
      background: #f2f9f4;
    }
    .que {
      margin: 0;
      font-family: ui-monospace, monospace;
      font-size: 0.82rem;
      color: #1e7e34;
    }
    .salida {
      margin: 0;
    }
    .lista {
      margin: 0;
      padding-left: 1.1rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0 1rem;
      list-style: none;
    }
    .lista li {
      font-variant-numeric: tabular-nums;
    }
  </style>
</head>

<signal-control>
  <template shadowrootmode="open">
    <section class="panel">
      <div class="row">
        <button class="menos" @click=@menos>−1</button>
        <output class="valor">@count()</output>
        <button class="mas" @click=@mas>+1</button>
      </div>

      <div class="caso" data-caso="if">
        <p class="que">@@if</p>
        @if (count() > 1) {
          <p class="salida">Hay más de uno.</p>
        } else {
          <p class="salida">Hay uno o ninguno.</p>
        }
      </div>

      <div class="caso" data-caso="switch">
        <p class="que">@@switch</p>
        @switch (count()) {
          case 0:
            <p class="salida">cero</p>
          case 1:
            <p class="salida">uno</p>
          default:
            <p class="salida">muchos</p>
        }
      </div>

      <div class="caso" data-caso="foreach">
        <p class="que">@@foreach</p>
        <ul class="lista">
          @foreach (const fila of filas()) key (fila.id) {
            <li>fila @fila.id</li>
          }
        </ul>
      </div>

      <div class="caso" data-caso="for">
        <p class="que">@@for</p>
        <ul class="lista">
          @for (let i = 0; i < count(); i++) key (i) {
            <li>índice @i</li>
          }
        </ul>
      </div>
    </section>
  </template>
</signal-control>
