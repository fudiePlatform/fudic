<link rel="component" href="./signal-grandchild.fud">

@code {
  import type { Signal } from "@fudic/core";

  // Declarar la prop como `Signal<number>` es todo (decisión 86 de props-spec): lo que cruza
  // el shadow boundary es el OBJETO, no su valor. El compilador lee esta línea desde el padre
  // y cruza `count` desnudo; el runtime pone la misma celda en las dos casillas.
  //
  // Y con el objeto llega todo lo demás: derivar de él, reenviarlo al nieto y escribirlo.
  const { value } = props<{ value: Signal<number> }>();

  @client {
    import { computed } from "@fudic/core";

    // Imposible con un número: un derivado necesita una fuente que le avise.
    const doble = computed(() => value() * 2);
  }
}

<head>
  <style>
    .out {
      margin: 0;
      padding: 0.75rem 0.9rem;
      border: 1px dashed #34a853;
      border-radius: 8px;
      background: #f2f9f4;
      font-variant-numeric: tabular-nums;
      strong {
        font-size: 1.35rem;
      }
    }
    .what {
      margin: 0.5rem 0 0;
      font-size: 0.78rem;
      color: #1e7e34;
    }
  </style>
</head>

<signal-display>
  <template shadowrootmode="open">
    <p class="out">
      El hijo tiene la celda: <strong>@value()</strong> — y deriva de ella:
      <strong>@doble()</strong>
    </p>
    <p class="what">Una prop <code>Signal&lt;T&gt;</code> es un reactivo más del hijo.</p>
    <signal-grandchild .value=@value></signal-grandchild>
  </template>
</signal-display>
