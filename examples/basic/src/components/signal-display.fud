@code {
  // A number, like every child. `.value="@count"` names the signal, and naming it is what
  // buys a channel of its own — but what CROSSES is the read, never the object: a signal is
  // a function with a live set of subscribers inside, and the payload of an instance that
  // came from the server is JSON.
  const { value = 0 } = props<{ value?: number }>();
}

<head>
  <style>
    :host {
      display: block;
    }
    .out {
      margin: 0;
      padding: 0.75rem 0.9rem;
      border: 1px dashed #34a853;
      border-radius: 8px;
      background: #f2f9f4;
      font-variant-numeric: tabular-nums;
      strong {
        font-size: 1.35rem;
      }
    }
    .what {
      margin: 0.5rem 0 0;
      font-size: 0.78rem;
      color: #1e7e34;
    }
  </style>
</head>

<signal-display>
  <template shadowrootmode="open">
    <p class="out">Valor recibido por el hijo: <strong>@value</strong></p>
    <p class="what">Al padre le basta nombrar la signal: el canal lo abre él.</p>
  </template>
</signal-display>
