@code {
  const { current = "" } = props<{ current?: string }>();
}

<head>
  <style>
    :host {
      display: block;
    }
    nav {
      display: flex;
      gap: 1.25rem;
      align-items: baseline;
      padding: 0.9rem 0;
      border-bottom: 1px solid #e6e6e6;
      a {
        color: #1a73e8;
        text-decoration: none;
        font-weight: 500;
      }
      a[aria-current="page"] {
        color: #202124;
      }
    }
  </style>
</head>

<site-nav>
  <template shadowrootmode="open">
    <nav>
      <a href="/" aria-current="@(current === 'home' ? 'page' : 'false')">fudic</a>
      <a href="/blog" aria-current="@(current === 'blog' ? 'page' : 'false')">Blog</a>
      <a href="/mapas" aria-current="@(current === 'mapas' ? 'page' : 'false')">Mapas</a>
      <a href="/hidratacion" aria-current="@(current === 'hidratacion' ? 'page' : 'false')">Hidratación</a>
      <a href="/about" aria-current="@(current === 'about' ? 'page' : 'false')">Acerca de</a>
    </nav>
  </template>
</site-nav>
