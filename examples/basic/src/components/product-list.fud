@code {
  // El emisor del bus. `emit` fuerza `bubbles` y `composed`, así que el evento sube hasta
  // `document`, donde vive el suscriptor. El nombre es un literal, que es la única forma
  // que v1 resuelve — y es lo que pone este tag en el lado emisor de `fud-bus`.
  @client {
    import { emit } from '@fudic/dom';

    function add(precio) {
      emit('carrito', precio);
    }
  }
}

<head>
  <style>
    :host {
      display: block;
    }
    .panel {
      display: grid;
      gap: 0.5rem;
      border: 1px solid #dcdcdc;
      border-radius: 10px;
      padding: 0.9rem 1.1rem;
      background: white;
    }
    button {
      font: inherit;
      text-align: left;
      padding: 0.45rem 0.8rem;
      border: 1px solid #dcdcdc;
      border-radius: 6px;
      background: white;
      cursor: pointer;
    }
  </style>
</head>

<product-list>
  <template shadowrootmode="open">
    <section class="panel">
      <button class="add" @click="@add(3.5)">Taza — 3,50 €</button>
      <button class="add" @click="@add(2)">Pegatina — 2,00 €</button>
      <button class="add" @click="@add(2)">Chapa — 2,00 €</button>
    </section>
  </template>
</product-list>
