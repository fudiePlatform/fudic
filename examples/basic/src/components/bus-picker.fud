<link rel="component" href="./bus-option.fud">

@code {
  type Option = { label: string; picked: boolean };

  const { options = [] } = props<{ options?: readonly Option[] }>();

  import { emit } from "@fudic/dom";

  // The emitting end of the bus. The name is a string literal, which is the only form
  // v1 resolves — and it is what puts this tag on the emitting side of `fud-bus`.
  function pick(label: string) {
    emit("picked", label);
  }
}

<head>
  <style>
    .panel {
      display: grid;
      gap: 0.5rem;
    }
  </style>
</head>

<bus-picker>
  <template shadowrootmode="open" shadowrootadoptedstylesheets="panel">
    @* Un solo `@click`, en el panel: cada opción se marca con `delegate:option`. *@
    <section class="panel" @click=@pick(option.label)>
      @foreach (const option of options) key (option.label) {
        <bus-option
          .label=@option.label
          .picked=@option.picked
          delegate:option="click"
        ></bus-option>
      }
    </section>
  </template>
</bus-picker>
