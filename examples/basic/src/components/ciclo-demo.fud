@code {
  /**
   * An instance that writes down in the page's record every moment of its life: the seven
   * hooks. It reflects its `state` prop on its own tag, and the border changes with it.
   */
  const { name = "", state = "inactive" } = props<{
    /** What this instance is called in the record. */
    name?: string;
    /** "active" paints the border green. */
    state?: "active" | "inactive";
  }>();

  import { note } from "../store/ciclo.js";

  beforeHydrate(() => note(name, "beforeHydrate"));
  afterHydrate(() => note(name, "afterHydrate"));
  beforeCreate(() => note(name, "beforeCreate"));
  afterCreate(() => note(name, "afterCreate"));
  onConnect(() => {
    note(name, "onConnect");
  });
  onDisconnect(() => note(name, "onDisconnect"));
  onDispose(() => note(name, "onDispose"));
}

<head>
  <style>
    :host {
      display: block;
      border: 2px solid #9aa0a6;
      border-radius: var(--radius-box);
      padding: 0.5rem 0.8rem;
    }
    :host([state="active"]) {
      border-color: #34a853;
    }
    p {
      margin: 0;
    }
  </style>
</head>

<ciclo-demo state=@state>
  <template shadowrootmode="open">
    <p><strong>@name</strong> · @state</p>
  </template>
</ciclo-demo>
