<link rel="component" href="./form-errores.fud">
<link rel="server" href="./user-form.fudapi">

@code {
  import { signal } from "@fudic/core";
  import type { Person } from "fudic:routes/usuarios";

  const aviso = signal("");

  // `hecho` recibe lo que devolvió el handler de `save`: la `Person` de su `.fudapi`. Un 400,
  // 409 o 422 no llega aquí: el formulario se los queda (`catches` de person.fudapi) y ya están
  // pintados en él. La persona guardada sale del componente con el propio `fudic:result`, que
  // cruza el shadow root: quien lo use la recoge en su tag, con `@fudic:result` (/usuarios).
  // Y el formulario vuelve a como está declarado, listo para la siguiente alta.
  function hecho(persona: Person) {
    aviso.set(`Guardado: ${persona.name} (id ${String(persona.id)}).`);
    personForm.$reset();
  }
}

<head>
  <style>
    form {
      display: grid;
      gap: var(--gap);
      border: 1px solid var(--line);
      border-radius: var(--radius-box);
      padding: 1.1rem;
      background: var(--surface);
    }
    label {
      font-weight: 500;
    }
    input, textarea {
      font: inherit;
      padding: var(--pad-field);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }
    .campo {
      display: grid;
      gap: 0.3rem;
    }
    .check {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .error {
      color: #b3261e;
      font-size: 0.85rem;
    }
    .error:empty {
      display: none;
    }
    .aviso:empty {
      display: none;
    }
    button {
      justify-self: start;
      border-color: var(--brand);
      background: var(--brand);
      color: white;
    }
    [aria-invalid="true"] {
      border-color: #b3261e;
    }
  </style>
</head>

<user-form>
  <template shadowrootmode="open">
    <form control=@personForm form:=@save @fudic:result=@hecho>
      @* El resumen lo pinta un componente propio con `$issues()`, no un `summary=`. *@
      <form-errores .issues=@personForm.$issues()></form-errores>

      <div class="campo">
        <label for="nombre">Nombre</label>
        <input id="nombre" control=@personForm.name type="text">
        <small class="error" error=@personForm.name></small>
      </div>

      <div class="campo">
        <label for="email">Email</label>
        <input id="email" control=@personForm.email type="email">
        <small class="error" error=@personForm.email></small>
      </div>

      <div class="campo">
        <label for="edad">Edad</label>
        <input id="edad" control=@personForm.age type="number">
        <small class="error" error=@personForm.age></small>
      </div>

      <div class="check">
        <input id="activo" control=@personForm.active type="checkbox">
        <label for="activo">Activo</label>
      </div>

      <div class="campo">
        <label for="notas">Notas</label>
        <textarea id="notas" control=@personForm.notes rows="3"></textarea>
      </div>

      <div class="campo">
        <label for="foto">Foto</label>
        @* Sin `accept`: el compilador lo escribe con el de la regla, y el diálogo filtra igual. *@
        <input id="foto" type="file" control=@personForm.avatar>
        <small class="error" error=@personForm.avatar></small>
      </div>

      @if (personForm.$progress() !== null) {
        <progress aria-label="Subiendo" value=@(personForm.$progress()?.loaded) max=@(personForm.$progress()?.total)></progress>
      }

      <button type="submit">Dar de alta</button>
      <p class="aviso" role="status">@aviso()</p>
    </form>
  </template>
</user-form>
