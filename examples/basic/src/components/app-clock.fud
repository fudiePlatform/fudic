@code {
  import { signal, effect, now } from "@fudic/core";
  import { date } from "@fudic/i18n";

  // El instante lo pone el servidor y viaja en `fud-state`: el cliente que hidrata sigue
  // desde él, sin llamar otra vez a `now()`.
  const ahora = signal(now());

  // La hora y la fecha son pipes del catálogo: cada runtime las formatea con su ICU.
  const hora = date({ timeStyle: "medium", timeZone: "Europe/Madrid" });
  const fecha = date({ weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Madrid" });

  effect(() => {
    const id = setInterval(() => ahora.set(new Date()), 1000);
    return () => clearInterval(id);
  });
}

<head>
  <style>
    :host { padding: 1rem 1.25rem; background: #e6e6e6; }
    .hora {
      font-size: 2.6rem;
      font-weight: 300;
      font-variant-numeric: tabular-nums;
      line-height: 1.1;
      color: #202124;
    }
    .fecha { margin-top: 0.35rem; font-size: 0.9rem; color: #1a5fb4; }
  </style>
</head>

<app-clock>
  <template shadowrootmode="open">
    <time class="hora">@(ahora() | hora)</time>
    <p class="fecha">@(ahora() | fecha)</p>
  </template>
</app-clock>
