{
  "name": "@fudic/example-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The component library of the workspace: .fud source, no dist, consumed by both apps.",
  "files": [
    "src",
    "ui.css",
    "fudic.json"
  ],
  "exports": {
    "./fudic.json": "./fudic.json",
    "./*.fud": "./src/components/*/*.fud",
    "./ui.css": "./ui.css"
  },
  "dependencies": {
    "@fudic/example-guia": "workspace:*"
  },
  "peerDependencies": {
    "@fudic/compiler": "0.0.1",
    "@fudic/core": "workspace:*",
    "@fudic/dom": "workspace:*"
  },
  "devDependencies": {
    "@fudic/compiler": "workspace:*",
    "@fudic/core": "workspace:*",
    "@fudic/dom": "workspace:*",
    "@fudic/ssr": "workspace:*",
    "@fudic/terms": "workspace:*",
    "@fudic/testing": "workspace:*",
    "@fudic/vite": "workspace:*",
    "@fudic/workbench": "workspace:*",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  },
  "scripts": {
    "test": "vitest run",
    "spec": "fudic-workbench run --pass-with-no-specs"
  }
}
