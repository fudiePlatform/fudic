<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- The layout of the library: every app that uses it writes this same line, and in each
         it resolves to that app's own worker. The URL is derived from the build's `base`, so in
         `admin` it is `/admin/fudic-sw.js` and its scope is `/admin/`. -->
    <script type="module" src="fudic:runtime"></script>

    @RenderHead()
  </head>
  <body>
    <main>@RenderBody()</main>
  </body>
</html>
