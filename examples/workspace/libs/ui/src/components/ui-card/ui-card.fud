@code {
  /**
   * A card with a title, framed with the guide's tokens. Whatever is written inside the tag (text,
   * a list, any markup) fills its default slot, under the title.
   */
  const { title } = props<{
    /** The heading of the card: one short line. */
    title: string;
  }>();
}

<head>
  <style>
    .card {
      border: 1px solid var(--guia-line);
      border-left: 3px solid var(--guia-accent);
      border-radius: var(--guia-radius);
      padding: var(--guia-pad);
      background: var(--guia-surface);
      h2 {
        margin: 0 0 0.35rem;
        font-size: 1.05rem;
      }
    }
  </style>
</head>

<ui-card>
  <template shadowrootmode="open" shadowrootadoptedstylesheets="h2">
    <article class="card">
      <h2>@title</h2>
      <slot></slot>
    </article>
  </template>
</ui-card>
