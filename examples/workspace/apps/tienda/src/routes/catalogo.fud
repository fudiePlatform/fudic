<link rel="layout" href="../layouts/_layout.fud">
<link rel="component" href="../components/tienda-card/tienda-card.fud">

@code {
  // A pipe of the library, imported by the package: written once in libs/ui.
  import iniciales from "@fudic/example-ui/pipes/iniciales";
  const autora = "ada lovelace";
}

<head>
  <title>Catálogo — Tienda</title>
</head>

<h1 data-app="tienda">Catálogo</h1>
<p class="autora">Seleccionado por @autora|iniciales</p>

<tienda-card .title="Sudadera">Interior de rizo.</tienda-card>
<tienda-card .title="Gorra">Visera curva.</tienda-card>
