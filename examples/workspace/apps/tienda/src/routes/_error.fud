<link rel="layout" href="../layouts/_layout.fud">

<head>
  <title>Algo ha fallado — tienda</title>
</head>

<section data-error-page="tienda">
  @* La tienda depende de `ui`, que trae su página de error, pero tiene la suya: la propia gana, y
     enlaza el layout de la tienda, el mismo que sus páginas. *@
  <h1>La tienda no encuentra eso (@data.status)</h1>
  <p><a href=@data.home>Volver a la tienda</a></p>
</section>
