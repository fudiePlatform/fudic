@code {
  const { title } = props<{ title: string }>();
}

<head>
  <style>
    :host {
      display: block;
    }
    .card {
      border: 1px solid #dcdcdc;
      border-radius: 10px;
      padding: 1rem 1.15rem;
      background: white;
      h2 {
        margin: 0 0 0.35rem;
        font-size: 1.05rem;
      }
    }
  </style>
</head>

<tienda-card>
  <template shadowrootmode="open">
    <article class="card">
      <h2>@title</h2>
      <slot></slot>
    </article>
  </template>
</tienda-card>
