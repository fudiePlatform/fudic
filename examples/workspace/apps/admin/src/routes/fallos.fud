<link rel="layout" href="@fudic/example-ui/layouts/_layout.fud">
<link rel="server" href="./fallos.fudapi">

@code {
  import { signal } from "@fudic/core";

  const respuesta = signal("");

  async function pedirSaludo() {
    respuesta.set(await saludo());
  }
}

<head>
  <title>Fallos — Administración</title>
</head>

@* Una app publicada bajo /admin/ no se sale de él en el navegador: sus llamadas, el token de
   csrf, sus reglas remotas, la página de error y las rutas de error-pages llevan el /admin/. *@
<h1 data-app="tienda-admin">Fallos</h1>

<p>
  <button id="saludo" @click=@pedirSaludo()>Saludar</button>
  <output id="respuesta">@respuesta()</output>
</p>
<p><button id="rompe" @click=@rompe()>Romper (500)</button></p>
<p><button id="prohibido" @click=@prohibido()>Prohibido (403)</button></p>

<form control=@altaForm form:=@alta>
  <label for="nombre">Nombre</label>
  <input id="nombre" type="text" control=@altaForm.nombre>
  <small id="nombre-error" error=@altaForm.nombre></small>
  <button type="submit">Dar de alta</button>
</form>
