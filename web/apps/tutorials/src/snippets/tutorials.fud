  <ol class="tutorial-list">
    @render tutorial("expressions", "Pintar valores con @(…)", "beginner", @current)
    @render tutorial("if-and-foreach", "Condiciones y listas", "beginner", @current)
    @render tutorial("props", "Pasar datos a un hijo", "beginner", @current)
    @render tutorial("slots", "Contenido por slot", "beginner", @current)
    @render tutorial("snippets", "Crear un snippet", "beginner", @current)
    @render tutorial("attributes-and-classes", "Atributos, propiedades y clases", "intermediate", @current)
    @render tutorial("spread-and-rest", "Spread y resto de props", "intermediate", @current)
    @render tutorial("ref", "Referencias con ref", "intermediate", @current)
    @render tutorial("raw", "HTML sin escapar con @raw", "intermediate", @current)
    @render tutorial("await", "Esperar datos con @await", "intermediate", @current)
    @render tutorial("safe-urls", "URLs en atributos", "intermediate", @current)
  </ol>
}

