@* A card of the home page: its picture, one category, how many tutorials it has and of which
   levels. Its title links to the first tutorial while there is one; until then the card says it is
   on its way. The link covers the whole card, but only the title is its name. *@
@snippet category(art: string, title: string, summary: string, count: number, beginner: boolean, intermediate: boolean, advanced: boolean, href: string = "") {
  <li class="category">
    <h2>
      @if (href !== "") {
        <a href=@href>@title</a>
      } else {
        @title
      }
    </h2>
    @render categoryArt(@art)
    <p class="summary">@summary</p>
    <p class="count">@(count === 1 ? "1 tutorial" : count + " tutoriales")</p>
    <ul class="levels" aria-label="Niveles">
      @if (beginner) {
        <li><span class="level" data-level="beginner">Principiante</span></li>
      }
      @if (intermediate) {
        <li><span class="level" data-level="intermediate">Intermedio</span></li>
      }
      @if (advanced) {
        <li><span class="level" data-level="advanced">Avanzado</span></li>
      }
    </ul>
    @if (href === "") {
      <p class="soon">En preparación</p>
    }
  </li>
}

@* The picture of a card: what the category teaches, drawn with real code and real results. Inline
   SVG so its colours are the guide's tokens and follow the theme; decorative, because the card's
   title already says it. Every picture is 240 by 132. *@
@snippet categoryArt(name: string) {
