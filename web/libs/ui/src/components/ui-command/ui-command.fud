@code {
  /**
   * A shell command on one button: the command is in view, and a press copies it. The page shows
   * it whole even before any script runs; the script only adds the copy. Its accessible name is
   * what it shows, the command and "Copiar", so a voice user can say what they see.
   */
  import { signal } from "@fudic/core";

  const { command = "" } = props<{
    /** The command to show and copy, without the prompt, e.g. "npx @fudic/cli new mi-app". */
    command?: string;
  }>();

  const copied = signal(false);

  async function copy() {
    try {
      await navigator.clipboard.writeText(command);
      copied.set(true);
      setTimeout(() => copied.set(false), 1600);
    } catch {
      copied.set(false);
    }
  }
}

<head>
  <style>
    :host {
      display: inline-flex;
    }
    button {
      flex: 1;
      gap: var(--guide-space-3);
      block-size: 3rem;
      padding: 0 1.375rem;
      font-family: var(--guide-font-mono);
      font-size: 0.9rem;
      font-weight: var(--guide-weight-normal);
      color: var(--guide-ink);
      background: var(--guide-raised);
      border: 1px solid var(--guide-rule);
    }
    button:hover {
      filter: none;
      border-color: var(--guide-line);
    }
    .prompt {
      color: var(--guide-accent);
    }
    .hint {
      min-inline-size: 5.2em;
      padding-inline-start: var(--guide-space-3);
      font-family: var(--guide-font-sans);
      font-size: var(--guide-text-xs);
      text-align: start;
      color: var(--guide-muted);
      border-inline-start: 1px solid var(--guide-rule);
    }
    .status {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    @media (prefers-reduced-motion: no-preference) {
      button {
        transition: scale var(--guide-duration-fast) var(--guide-easing);
      }
      button:active {
        scale: 0.98;
      }
    }
  </style>
</head>

<ui-command>
  <template shadowrootmode="open" shadowrootadoptedstylesheets="button">
    <button type="button" @click=@copy>
      <span><span class="prompt" aria-hidden="true">$</span> @command</span>
      <span class="hint">@(copied() ? "Copiado" : "Copiar")</span>
    </button>
    <span class="status" role="status">@(copied() ? "Comando copiado" : "")</span>
  </template>
</ui-command>
