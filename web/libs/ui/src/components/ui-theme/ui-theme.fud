@code {
  /**
   * The button that switches the site between light and dark. Until someone presses it, the site
   * follows the system; after, it keeps their choice for every page, in localStorage. It sets
   * `color-scheme` on <html>, and every token of the guide is a light-dark() that follows it.
   *
   * It is a toggle button: one name, "Tema oscuro", and aria-pressed says whether it is on.
   */
  import { signal } from "@fudic/core";

  const KEY = "fudic-theme";
  const dark = signal(false);

  function stored(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function show(on: boolean, choice: boolean) {
    const root = document.documentElement;
    if (choice) root.style.colorScheme = on ? "dark" : "light";
    else root.style.removeProperty("color-scheme");
    dark.set(on);
  }

  onConnect(() => {
    const system = matchMedia("(prefers-color-scheme: dark)");
    const sync = () => {
      const choice = stored();
      show(choice === null ? system.matches : choice === "dark", choice !== null);
    };
    sync();
    system.addEventListener("change", sync);
    return () => system.removeEventListener("change", sync);
  });

  function toggle() {
    const on = !dark();
    try {
      localStorage.setItem(KEY, on ? "dark" : "light");
    } catch {
      // Private mode without storage: the choice lasts this page only.
    }
    show(on, true);
  }
}

<head>
  <style>
    :host {
      display: inline-flex;
    }
    .theme {
      padding: var(--guide-space-2);
      color: var(--guide-muted);
      background: transparent;
      border: 1px solid var(--guide-rule);
      border-radius: var(--guide-radius-md);
    }
    .theme:hover {
      color: var(--guide-ink);
      filter: none;
    }
    .theme[aria-pressed="true"] .moon,
    .theme[aria-pressed="false"] .sun {
      display: none;
    }
    svg {
      display: block;
      inline-size: 1.25rem;
      block-size: 1.25rem;
    }
  </style>
</head>

<ui-theme>
  <template shadowrootmode="open" shadowrootadoptedstylesheets="button svg">
    <button
      type="button"
      class="theme"
      aria-label="Tema oscuro"
      aria-pressed=@(dark() ? 'true' : 'false')
      @click=@toggle>
      <svg
        class="moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      <svg
        class="sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><circle
          cx="12"
          cy="12"
          r="4"
        /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        /></svg>
    </button>
  </template>
</ui-theme>
