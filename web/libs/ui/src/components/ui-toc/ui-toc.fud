@code {
  /**
   * The headings of the page, marking the one being read. The links are the list written between
   * its tags, so they work without any script; this only moves aria-current as the page scrolls.
   *
   * The heading being read is the last one whose top has passed a line at a third of the window.
   * At the bottom of the page it is the last heading, which a short last section never takes up
   * to that line. A link that was clicked stays marked while the page scrolls to its heading.
   */
  onConnect((host) => {
    const pairs = [...host.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
      .map((link) => ({ link, target: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((pair): pair is { link: HTMLAnchorElement; target: HTMLElement } => pair.target !== null);
    if (pairs.length === 0) return;

    let current: HTMLAnchorElement | null = null;
    const mark = (link: HTMLAnchorElement | null) => {
      if (link === current) return;
      current?.removeAttribute("aria-current");
      link?.setAttribute("aria-current", "location");
      current = link;
    };

    const reading = (): HTMLAnchorElement | null => {
      const page = document.documentElement;
      if (window.scrollY > 0 && window.scrollY + window.innerHeight >= page.scrollHeight - 2) {
        return pairs[pairs.length - 1]!.link;
      }
      const line = window.innerHeight / 3;
      let found: HTMLAnchorElement | null = null;
      for (const { link, target } of pairs) {
        if (target.getBoundingClientRect().top <= line) found = link;
      }
      return found;
    };

    // After a click the page scrolls on its own: the clicked link keeps the mark until it stops.
    let held = false;
    let release = 0;
    const holdUntilStill = (ms: number) => {
      clearTimeout(release);
      release = window.setTimeout(() => {
        held = false;
      }, ms);
    };

    let frame = 0;
    const onScroll = () => {
      if (held) return holdUntilStill(150);
      if (frame !== 0) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        mark(reading());
      });
    };
    const onClick = (event: Event) => {
      const pair = pairs.find(({ link }) => link === (event.target as Element).closest("a"));
      if (pair === undefined) return;
      mark(pair.link);
      held = true;
      holdUntilStill(1000);
    };

    mark(reading());
    window.addEventListener("scroll", onScroll, { passive: true });
    host.addEventListener("click", onClick);
    return () => {
      window.removeEventListener("scroll", onScroll);
      host.removeEventListener("click", onClick);
      clearTimeout(release);
      cancelAnimationFrame(frame);
    };
  });
}

<ui-toc>
  <template shadowrootmode="open">
    <slot></slot>
  </template>
</ui-toc>
