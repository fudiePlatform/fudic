@* The pieces every page of the site shares, written in the light DOM so their links and headings
   belong to the document. *@

@snippet header() {
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="Fudic, inicio"><span class="at" aria-hidden="true">@@</span>fudic</a>
    <nav aria-label="Principal">
      <ul>
        <li><a href="/docs/getting-started">Documentación</a></li>
        <li><a href="https://github.com/fudiePlatform/fudic" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </nav>
  </header>
}

@snippet footer() {
  <footer class="site-footer">
    <p>Fudic, componentes web estándar pintados en el servidor. Licencia MIT.</p>
  </footer>
}

@snippet docsNav(current: string) {
  <details class="chapters">
    <summary>Capítulos</summary>
    <ol>
      <li><a href="/docs/getting-started" aria-current=@(current === "getting-started" ? "page" : false)>Empezar con Fudic</a></li>
      <li>
        <span class="chapter">El lenguaje <code>.fud</code></span>
        <ol>
          <li><a href="/docs/template-syntax" aria-current=@(current === "template-syntax" ? "page" : false)>Sintaxis de plantillas</a></li>
          <li><a href="/docs/template-syntax/components" aria-current=@(current === "components" ? "page" : false)>Componentes</a></li>
          <li><a href="/docs/template-syntax/routes-and-layouts" aria-current=@(current === "routes-and-layouts" ? "page" : false)>Rutas y layouts</a></li>
          <li><a href="/docs/template-syntax/snippets" aria-current=@(current === "snippets" ? "page" : false)>Snippets</a></li>
          <li><a href="/docs/template-syntax/expressions" aria-current=@(current === "expressions" ? "page" : false)>Expresiones y control de flujo</a></li>
          <li><a href="/docs/template-syntax/await" aria-current=@(current === "await" ? "page" : false)><code>@@await</code></a></li>
          <li><a href="/docs/template-syntax/attributes-and-properties" aria-current=@(current === "attributes-and-properties" ? "page" : false)>Atributos y propiedades</a></li>
          <li><a href="/docs/template-syntax/events" aria-current=@(current === "events" ? "page" : false)>Eventos</a></li>
          <li><a href="/docs/template-syntax/ref-and-raw" aria-current=@(current === "ref-and-raw" ? "page" : false)><code>ref</code> y <code>@@raw</code></a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Reactividad y ciclo de vida</span>
        <ol>
          <li><a href="/docs/reactivity" aria-current=@(current === "reactivity" ? "page" : false)>Signals</a></li>
          <li><a href="/docs/reactivity/lifecycle" aria-current=@(current === "lifecycle" ? "page" : false)>Ciclo de vida</a></li>
          <li><a href="/docs/reactivity/hydration" aria-current=@(current === "hydration" ? "page" : false)>Hidratación</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Estilos</span>
        <ol>
          <li><a href="/docs/styles" aria-current=@(current === "styles" ? "page" : false)>El CSS de un componente</a></li>
          <li><a href="/docs/styles/shared" aria-current=@(current === "styles-shared" ? "page" : false)>Hojas compartidas</a></li>
          <li><a href="/docs/styles/guide" aria-current=@(current === "styles-guide" ? "page" : false)>La guía de estilos</a></li>
          <li><a href="/docs/styles/delivery" aria-current=@(current === "styles-delivery" ? "page" : false)>Cómo llega el CSS</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Servidor y datos</span>
        <ol>
          <li><a href="/docs/server" aria-current=@(current === "server" ? "page" : false)>El contrato <code>.fudapi</code></a></li>
          <li><a href="/docs/server/types" aria-current=@(current === "server-types" ? "page" : false)>Tipos</a></li>
          <li><a href="/docs/server/functions" aria-current=@(current === "server-functions" ? "page" : false)>Funciones de servidor</a></li>
          <li><a href="/docs/server/task" aria-current=@(current === "server-task" ? "page" : false)><code>task</code></a></li>
          <li><a href="/docs/server/middlewares" aria-current=@(current === "server-middlewares" ? "page" : false)>Middlewares y cadena</a></li>
          <li><a href="/docs/server/rules" aria-current=@(current === "server-rules" ? "page" : false)>Reglas y patrones</a></li>
          <li><a href="/docs/server/pipes" aria-current=@(current === "server-pipes" ? "page" : false)>Pipes</a></li>
          <li><a href="/docs/server/session" aria-current=@(current === "server-session" ? "page" : false)>Sesión y cookies</a></li>
          <li><a href="/docs/server/running" aria-current=@(current === "server-running" ? "page" : false)>El servidor</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Páginas y rutas</span>
        <ol>
          <li><a href="/docs/routing" aria-current=@(current === "routing" ? "page" : false)>Rutas por carpetas</a></li>
          <li><a href="/docs/routing/data" aria-current=@(current === "routing-data" ? "page" : false)>Los datos de la página</a></li>
          <li><a href="/docs/routing/rendering" aria-current=@(current === "routing-rendering" ? "page" : false)>Cuándo se pinta: los modos</a></li>
          <li><a href="/docs/routing/error-page" aria-current=@(current === "routing-error-page" ? "page" : false)>La página de error</a></li>
          <li><a href="/docs/routing/early-hints" aria-current=@(current === "routing-early-hints" ? "page" : false)>Early hints</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Formularios</span>
        <ol>
          <li><a href="/docs/forms" aria-current=@(current === "forms" ? "page" : false)>El formulario</a></li>
          <li><a href="/docs/forms/binding" aria-current=@(current === "forms-binding" ? "page" : false)>Enlazar la vista</a></li>
          <li><a href="/docs/forms/validation" aria-current=@(current === "forms-validation" ? "page" : false)>Validación y validez</a></li>
          <li><a href="/docs/forms/submitting" aria-current=@(current === "forms-submitting" ? "page" : false)>Enviar al servidor</a></li>
          <li><a href="/docs/forms/events" aria-current=@(current === "forms-events" ? "page" : false)>Resultado y error</a></li>
          <li><a href="/docs/forms/files" aria-current=@(current === "forms-files" ? "page" : false)>Ficheros</a></li>
          <li><a href="/docs/forms/form-associated" aria-current=@(current === "forms-form-associated" ? "page" : false)>Controles form-associated</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Service Worker</span>
        <ol>
          <li><a href="/docs/service-worker" aria-current=@(current === "service-worker" ? "page" : false)>Qué hace</a></li>
          <li><a href="/docs/service-worker/caching" aria-current=@(current === "service-worker-caching" ? "page" : false)>Datos y páginas en caché</a></li>
          <li><a href="/docs/service-worker/configuration" aria-current=@(current === "service-worker-configuration" ? "page" : false)>Configuración</a></li>
          <li><a href="/docs/service-worker/isomorphic" aria-current=@(current === "service-worker-isomorphic" ? "page" : false)>Render isomórfico</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Internacionalización</span>
        <ol>
          <li><a href="/docs/i18n" aria-current=@(current === "i18n" ? "page" : false)>Traducir una app</a></li>
          <li><a href="/docs/i18n/code" aria-current=@(current === "i18n-code" ? "page" : false)>Textos en el código</a></li>
          <li><a href="/docs/i18n/catalogs" aria-current=@(current === "i18n-catalogs" ? "page" : false)>Los catálogos</a></li>
          <li><a href="/docs/i18n/urls" aria-current=@(current === "i18n-urls" ? "page" : false)>Idiomas y URLs</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Inyección de dependencias</span>
        <ol>
          <li><a href="/docs/di" aria-current=@(current === "di" ? "page" : false)>Servicios</a></li>
          <li><a href="/docs/di/providers" aria-current=@(current === "di-providers" ? "page" : false)>Dueños y subárboles</a></li>
          <li><a href="/docs/di/server" aria-current=@(current === "di-server" ? "page" : false)>Servidor y navegador</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Rendimiento</span>
        <ol>
          <li><a href="/docs/performance" aria-current=@(current === "performance" ? "page" : false)>Qué la hace rápida</a></li>
          <li><a href="/docs/performance/caching" aria-current=@(current === "performance-caching" ? "page" : false)>Las cachés del navegador</a></li>
          <li><a href="/docs/performance/lighthouse" aria-current=@(current === "performance-lighthouse" ? "page" : false)>Medir con Lighthouse</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Seguridad</span>
        <ol>
          <li><a href="/docs/security" aria-current=@(current === "security" ? "page" : false)>Lo que trae de serie</a></li>
          <li><a href="/docs/security/headers" aria-current=@(current === "security-headers" ? "page" : false)>Las cabeceras</a></li>
          <li><a href="/docs/security/csp" aria-current=@(current === "security-csp" ? "page" : false)>La CSP</a></li>
          <li><a href="/docs/security/trusted-types" aria-current=@(current === "security-trusted-types" ? "page" : false)>HTML seguro</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Pruebas</span>
        <ol>
          <li><a href="/docs/testing" aria-current=@(current === "testing" ? "page" : false)>Criterios</a></li>
          <li><a href="/docs/testing/workbench" aria-current=@(current === "testing-workbench" ? "page" : false)>El workbench</a></li>
