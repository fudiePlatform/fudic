@* The pieces every page of the site shares, written in the light DOM so their links and headings
   belong to the document. *@

@snippet header() {
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="Fudic, inicio"><span class="at" aria-hidden="true">@@</span>fudic</a>
    <nav aria-label="Principal">
      <ul>
        <li><a href="/docs/getting-started">Documentación</a></li>
        <li><a href="/tutorials/">Tutoriales</a></li>
        <li><a href="/mcp/">MCP</a></li>
        <li><a href="https://github.com/fudiePlatform/fudic" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </nav>
    <ui-theme></ui-theme>
  </header>
}

@* The close of every page: the line that sums Fudic up, what proves it, and the ways on. *@
@snippet footer() {
  <footer class="site-footer">
    <p class="motto"><span class="at" aria-hidden="true">@@</span>Lo que aprendes con Fudic es la web, no Fudic.</p>
    <p class="facts">100 en Lighthouse, en móvil y escritorio · La seguridad del navegador, de serie · Solo estándares</p>
    <nav aria-label="Pie de página">
      <ul>
        <li><a href="/docs/getting-started">Documentación</a></li>
        <li><a href="/tutorials/">Tutoriales</a></li>
        <li><a href="/mcp/">MCP</a></li>
        <li><a href="https://github.com/fudiePlatform/fudic" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="https://github.com/fudiePlatform/fudic/blob/main/LICENSE" target="_blank" rel="noopener">Licencia MIT</a></li>
      </ul>
    </nav>
  </footer>
}

@* The foot of a page: the page before it on the left and the page after it on the right, in the
   order the chapters are read. Each side is a URL and the title it leads to, passed by name; a
   page leaves out a side it has nothing on, like the first page's previous one. The link says the
   title because "Next" alone tells nothing. *@
@snippet pager(prev: string = "", prevTitle: string = "", next: string = "", nextTitle: string = "") {
  <nav class="pager" aria-label="Anterior y siguiente">
    @if (prev !== "") {
      <a class="prev" href=@prev rel="prev"><span class="label">Anterior</span> <span class="title">@prevTitle</span></a>
    }
    @if (next !== "") {
      <a class="next" href=@next rel="next"><span class="label">Siguiente</span> <span class="title">@nextTitle</span></a>
    }
  </nav>
}

@snippet docsNav(current: string) {
