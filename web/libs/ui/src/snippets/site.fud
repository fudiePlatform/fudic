      <li>
        <details class="chapter" open=@(current === "template-syntax" || current === "components" || current === "routes-and-layouts" || current === "snippets" || current === "expressions" || current === "await" || current === "attributes-and-properties" || current === "events" || current === "ref-and-raw")>
          <summary>El lenguaje <code>.fud</code></summary>
