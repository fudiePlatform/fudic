@* The pages of the MCP section, in the order they are read. Same shape as docsNav: a page passes
   its own id to mark itself. *@
@snippet mcpNav(current: string) {
  <details class="toggle"><summary>Páginas</summary></details>
  <ol class="chapters">
      <li><a href="/mcp/" aria-current=@(current === "mcp" ? "page" : false)>Trabajar con el MCP</a></li>
      <li><a href="/mcp/fudic" aria-current=@(current === "fudic" ? "page" : false)>Qué es Fudic</a></li>
      <li><a href="/mcp/conversation" aria-current=@(current === "conversation" ? "page" : false)>Una conversación de principio a fin</a></li>
      <li>
        <details class="chapter" open=@(current === "connect" || current === "chat")>
          <summary>Conectarlo</summary>
          <ol>
            <li><a href="/mcp/connect" aria-current=@(current === "connect" ? "page" : false)>Desde un agente</a></li>
            <li><a href="/mcp/connect/chat" aria-current=@(current === "chat" ? "page" : false)>Desde un chat</a></li>
        </ol>
        </details>
      </li>
      <li>
        <details class="chapter" open=@(current === "phases" || current === "approval" || current === "project")>
          <summary>Por dentro</summary>
          <ol>
            <li><a href="/mcp/phases" aria-current=@(current === "phases" ? "page" : false)>Las fases de una pieza</a></li>
            <li><a href="/mcp/approval" aria-current=@(current === "approval" ? "page" : false)>Aprobar, caducar y reabrir</a></li>
            <li><a href="/mcp/project" aria-current=@(current === "project" ? "page" : false)>Lo que genera la CLI</a></li>
        </ol>
        </details>
      </li>
      <li><a href="/mcp/tools" aria-current=@(current === "tools" ? "page" : false)>Las herramientas</a></li>
  </ol>
}
