          <li><a href="/docs/testing/terms" aria-current=@(current === "testing-terms" ? "page" : false)>Tus propios pasos</a></li>
          <li><a href="/docs/testing/unit" aria-current=@(current === "testing-unit" ? "page" : false)>Tests unitarios</a></li>
          <li><a href="/docs/testing/history" aria-current=@(current === "testing-history" ? "page" : false)>Historial y aprobación</a></li>
        </ol>
      </li>
      <li>
        <span class="chapter">Configuración</span>
        <ol>
          <li><a href="/docs/configuration" aria-current=@(current === "configuration" ? "page" : false)><code>fudic.json</code></a></li>
          <li><a href="/docs/configuration/fields" aria-current=@(current === "configuration-fields" ? "page" : false)>Estilos, idiomas y servidor</a></li>
