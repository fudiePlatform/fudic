<!DOCTYPE html>
@* The documentation: the site header, the chapters on the left, the page in the middle and its
   headings on the right. A page fills `nav` with the chapter list marking itself, and `toc`
   with the links to its own headings. *@
<html lang="es">
  <head>
    <link rel="snippet" href="../snippets/site.fud">
    <link rel="component" href="../components/ui-nav/ui-nav.fud">

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* The site's only web font, fetched with the HTML instead of after the CSS. By path, not by
       package name: a <link href> cannot name another package's file yet. *@
    <link rel="preload" href="../../../guide/fonts/inter-tight-wght-400-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="../styles/docs.css">
    @* Keep this line: fudic puts its scripts here. *@
    <script type="module" src="fudic:runtime"></script>
    @RenderHead()
  </head>
  <body>
    <a class="skip" href="#content">Saltar al contenido</a>
    @render header()

    <div class="docs">
      <nav class="docs-nav" aria-label="Capítulos">
        <ui-nav>@RenderSection(nav)</ui-nav>
      </nav>

      <aside class="docs-toc" aria-label="En esta página">
        @RenderSection(toc)
      </aside>

      <main id="content" class="docs-page">@RenderBody()</main>
    </div>

    @render footer()
  </body>
</html>
