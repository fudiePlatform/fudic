    "@fudic/cli": "workspace:*",
    "@fudic/core": "workspace:*",
    "@fudic/dom": "workspace:*",
    "@fudic/ssr": "workspace:*",
    "@fudic/terms": "workspace:*",
    "@fudic/testing": "workspace:*",
    "@fudic/vite": "workspace:*",
    "@fudic/workbench": "workspace:*",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@web/guide": "workspace:*"
  }
}
